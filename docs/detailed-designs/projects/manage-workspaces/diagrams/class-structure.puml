@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
title Class structure - Create and manage project workspaces
left to right direction
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
class WorkspacesController {
  -sender: ISender
}
class Workspace {
  +id: Guid
  +name: string
  +description: string?
  +mode: DeliveryMode
  +responsibleLeadId: Guid?
  +version: long
  +edit(name: string, description: string?, leadId: Guid?): void
  +checkDeletion(workItemTotal: int, sprintTotal: int): void
}
interface IMissionControlDataSession {
  +ListWorkspacesAsync(query: ListWorkspacesQuery, ct: CancellationToken): Task<WorkspaceList>
  +LoadWorkspaceDetailAsync(id: Guid, ct: CancellationToken): Task<WorkspaceDetail?>
  +LoadLeadReferenceAsync(leadId: Guid, ct: CancellationToken): Task<LeadReference?>
  +LoadWorkspaceAsync(id: Guid, ct: CancellationToken): Task<Workspace?>
  +LoadWorkspaceContentCountsAsync(workspaceId: Guid, ct: CancellationToken): Task<WorkspaceContentCounts>
  +AddWorkspace(workspace: Workspace): void
  +RemoveWorkspace(workspace: Workspace): void
  +AddAuditEvent(auditEvent: AuditEvent): void
  +BeginWorkspaceTransactionAsync(workspaceId: Guid, ct: CancellationToken): Task
  +SaveChangesAsync(ct: CancellationToken): Task
}
note right of IMissionControlDataSession
  Scoped view of the shared port; only the members
  this slice uses. ListWorkspacesAsync is one statement
  (window total); LoadWorkspaceDetailAsync is one snapshot.
  Success audits go through AddAuditEvent and commit
  with the change in SaveChangesAsync.
  Only deletion takes the workspace lock; a lock-wait
  timeout maps to 503 with Retry-After, nothing changed.
end note
class MissionControlDataSession
IMissionControlDataSession <|.. MissionControlDataSession

class ListWorkspacesQuery {
  +page: int
  +pageSize: int
  +responsibleLeadId: Guid?
}
class ListWorkspacesQueryHandler {
  +handle(request: ListWorkspacesQuery, ct: CancellationToken): Task<WorkspaceList>
}
class LeadReference {
  +id: Guid
  +name: string
}
class WorkspaceList {
  +items: WorkspaceListItem[]
  +totalCount: int
  +page: int
  +pageSize: int
  +responsibleLead: LeadReference?
}
note right of WorkspaceList
  responsibleLead echoes the filter for
  "Projects led by ..."; a malformed or
  unknown responsibleLeadId returns 400.
end note
class WorkspaceListItem {
  +id: Guid
  +name: string
  +mode: DeliveryMode
  +responsibleLeadId: Guid?
  +responsibleLeadName: string?
  +storiesDone: int
  +storiesTotal: int
  +activeSprintName: string?
  +activeSprintEndDate: DateOnly?
  +sprintsPaused: bool
}
note right of WorkspaceListItem
  No description (up to 10,000 characters);
  the overview returns it. Active sprint name and
  Toronto end date, or sprintsPaused when Kanban
  keeps sprints. Story counts are set-based over
  every persisted story.
end note
WorkspacesController ..> ListWorkspacesQuery : dispatches
ListWorkspacesQueryHandler ..> ListWorkspacesQuery : handles
ListWorkspacesQueryHandler --> WorkspaceList : returns
ListWorkspacesQueryHandler ..> IMissionControlDataSession : LoadLeadReferenceAsync; ListWorkspacesAsync
WorkspaceList *-- "0..100" WorkspaceListItem
WorkspaceList *-- "0..1" LeadReference

class GetWorkspaceQuery {
  +id: Guid
}
class GetWorkspaceQueryHandler {
  +handle(request: GetWorkspaceQuery, ct: CancellationToken): Task<WorkspaceDetail>
}
class WorkspaceDetail {
  +id: Guid
  +key: string
  +name: string
  +description: string?
  +mode: DeliveryMode
  +responsibleLeadId: Guid?
  +responsibleLeadName: string?
  +version: long
  +workItemTotal: int
  +counts: TypeStatusCount[]
  +typeTotals: TypeCount[4]
  +activeSprint: SprintSummary?
  +nextPlannedSprint: SprintSummary?
  +latestClosedSprint: SprintSummary?
  +keptSprints: SprintSummary[]
}
note right of WorkspaceDetail
  Scrum: active, next planned (earliest start date,
  then ID), and latest closed sprint (latest closure,
  then ID). Kanban: keptSprints holds planned and
  closed sprints by planned start date, newest first,
  then ID, at most 25, each flagged paused.
  counts, typeTotals, and workItemTotal are computed
  on the server, never summed from rendered cells.
  key: the project-local display key prefix (HCK);
  allocation policy <TO SUPPLY>.
end note
class TypeStatusCount {
  +type: WorkItemType
  +status: WorkStatus
  +count: int
}
class SprintSummary {
  +sprintId: Guid
  +name: string
  +status: SprintStatus
  +goal: string?
  +startDate: DateOnly
  +endDate: DateOnly
  +storiesDone: int
  +storiesTotal: int
  +paused: bool
}
note bottom of SprintSummary
  Toronto calendar dates. A closed sprint's
  done/total is its recorded closure outcome.
end note
WorkspacesController ..> GetWorkspaceQuery : dispatches
GetWorkspaceQueryHandler ..> GetWorkspaceQuery : handles
GetWorkspaceQueryHandler --> WorkspaceDetail : returns; 404 when missing
GetWorkspaceQueryHandler ..> IMissionControlDataSession : LoadWorkspaceDetailAsync
WorkspaceDetail *-- "12" TypeStatusCount
WorkspaceDetail *-- "4" TypeCount
WorkspaceDetail *-- SprintSummary

class CreateWorkspaceCommand {
  +name: string
  +description: string?
  +mode: DeliveryMode
  +responsibleLeadId: Guid?
}
class CreateWorkspaceCommandHandler {
  +handle(request: CreateWorkspaceCommand, ct: CancellationToken): Task<SavedWorkspaceResult>
}
class SavedWorkspaceResult {
  +id: Guid
  +version: long
  +name: string
}
WorkspacesController ..> CreateWorkspaceCommand : dispatches
CreateWorkspaceCommandHandler ..> CreateWorkspaceCommand : handles
CreateWorkspaceCommandHandler --> Workspace : creates
CreateWorkspaceCommandHandler ..> IMissionControlDataSession : loads lead; adds workspace and audit; saves
CreateWorkspaceCommandHandler ..> SavedWorkspaceResult : returns

class UpdateWorkspaceCommand {
  +id: Guid
  +name: string
  +description: string?
  +responsibleLeadId: Guid?
  +expectedVersion: long
}
class UpdateWorkspaceCommandHandler {
  +handle(request: UpdateWorkspaceCommand, ct: CancellationToken): Task<SavedWorkspaceResult>
}
WorkspacesController ..> UpdateWorkspaceCommand : dispatches
UpdateWorkspaceCommandHandler ..> UpdateWorkspaceCommand : handles
UpdateWorkspaceCommandHandler --> Workspace : loads / applies
UpdateWorkspaceCommandHandler ..> IMissionControlDataSession : loads; loads lead; adds audit; saves (version guard)
UpdateWorkspaceCommandHandler ..> SavedWorkspaceResult : returns

class DeleteWorkspaceCommand {
  +id: Guid
}
class DeleteWorkspaceCommandHandler {
  +handle(request: DeleteWorkspaceCommand, ct: CancellationToken): Task
}
class WorkspaceContentCounts {
  +workItemTotal: int
  +workItemCounts: TypeCount[4]
  +sprintTotal: int
  +sprintCounts: SprintStatusCount[3]
}
class WorkspaceInUseProblem {
  +status: 409
  +content: WorkspaceContentCounts
}
note bottom of WorkspaceInUseProblem
  Counts only: work items by type, sprints by
  status. No item or sprint lists. Nothing is
  deleted or cascaded.
end note
class TypeCount {
  +type: WorkItemType
  +count: int
}
class SprintStatusCount {
  +status: SprintStatus
  +count: int
}
WorkspaceContentCounts *-- "4" TypeCount
WorkspaceContentCounts *-- "3" SprintStatusCount
WorkspaceInUseProblem *-- WorkspaceContentCounts
WorkspacesController ..> DeleteWorkspaceCommand : dispatches
DeleteWorkspaceCommandHandler ..> DeleteWorkspaceCommand : handles
DeleteWorkspaceCommandHandler --> Workspace : loads / checks
DeleteWorkspaceCommandHandler ..> WorkspaceInUseProblem : 409 when content exists
DeleteWorkspaceCommandHandler ..> IMissionControlDataSession : locks; loads counts; removes; adds audit; saves

enum SprintStatus {
  Planned
  Active
  Closed
}
SprintSummary --> SprintStatus
SprintStatusCount --> SprintStatus
@enduml
