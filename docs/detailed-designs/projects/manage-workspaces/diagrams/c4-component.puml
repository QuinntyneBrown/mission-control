@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components - Create and manage project workspaces
Container(web, "Mission Control web client", "Angular", "ProjectListPage, ProjectLayoutPage, ProjectOverviewPage, BoardModeGuard, ProjectFormDialog, ProjectDeleteDialog / WorkspaceListView, ProjectHeaderView, WorkspaceOverviewView, WorkspaceForm, WorkspaceDeleteForm, LeadPicker")
ContainerDb(db, "Mission Control database", "SQL", "Versioned feature records and audit events")
Container_Boundary(api, "MissionControl.Api runtime") {
  Component(ctrl, "WorkspacesController", "API boundary", "Binds request and dispatches through MediatR 12.5.0")
  Component(access, "CurrentAccountAuthorization", "API authentication / authorization", "Validates JWT and checks current SQL account access")
  Component(validation, "ValidationBehavior", "Application pipeline", "Invokes request validators")
  Component(entity, "Workspace", "Domain entity", "Settings, version, and deletion rule")
  Component(store, "MissionControlDataSession", "Infrastructure", "Implements IMissionControlDataSession: typed reads, workspace lock, SaveChangesAsync")
Rel(web, access, "Reads through workspace resources; mutates through promises (IWorkspaceService / WorkspaceService)", "HTTPS")
Rel(access, db, "Checks current access for protected requests", "SQL")
Rel(access, ctrl, "Forwards authorized request")
Rel(ctrl, validation, "Sends typed request")
Component(h0, "ListWorkspacesQueryHandler", "Application / MediatR", "Read the paged list, optionally filtered by responsible lead; no descriptions")
Rel(validation, h0, "Dispatches validated request")
Rel(h0, store, "One statement: rows, window total, story counts, active sprint")
Component(h4, "GetWorkspaceQueryHandler", "Application / MediatR", "Read one workspace overview with counts and sprint summary")
Rel(validation, h4, "Dispatches validated request")
Rel(h4, store, "Reads settings, counts, and sprints in one snapshot")
Component(h1, "CreateWorkspaceCommandHandler", "Application / MediatR", "Create workspace")
Rel(validation, h1, "Dispatches validated request")
Rel(h1, entity, "Creates workspace with initial mode")
Rel(h1, store, "Checks lead; inserts with audit via SaveChangesAsync")
Component(h2, "UpdateWorkspaceCommandHandler", "Application / MediatR", "Edit workspace settings")
Rel(validation, h2, "Dispatches validated request")
Rel(h2, entity, "Edits name, description, lead")
Rel(h2, store, "Loads workspace; SaveChangesAsync checks expectedVersion")
Component(h3, "DeleteWorkspaceCommandHandler", "Application / MediatR", "Delete empty workspace")
Rel(validation, h3, "Dispatches validated request")
Rel(h3, entity, "checkDeletion(counts)")
Rel(h3, store, "Takes workspace lock; loads content counts; deletes with audit")
}
Rel(store, db, "Executes bounded queries / atomic writes", "SQL")
@enduml
