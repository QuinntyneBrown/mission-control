@startuml
!include <C4/C4_Container>
LAYOUT_WITH_LEGEND()
title Containers - Change workspace delivery mode
Person(actor, "Authorized user", "Change workspace delivery mode")
System_Boundary(mc, "Mission Control") {
  Container(web, "Mission Control web client", "Angular", "Change workspace delivery mode")
  Container(api, "MissionControl.Api", ".NET", "Authorized application handlers")
  ContainerDb(db, "Mission Control database", "SQL - provider <TO SUPPLY>", "Workspace and related records")
}
Rel(actor, web, "Uses")
Rel(web, api, "Requests feature behavior", "HTTPS / JSON")
Rel(api, db, "Reads or commits feature records", "Parameterized SQL")
@enduml
