@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
title Behavior - Confirm delivery mode change
actor "Administrator" as actor
box "Frontend - Mission Control application" #E0F2FE
  participant "ProjectOverviewPage\nModeChangeDialog / WorkspaceView" as page
  participant "IWorkspaceService / WorkspaceService" as client
end box
box "Backend - MissionControl.Api" #D1FADF
  participant "CurrentAccountAuthorization" as access
  participant "WorkspacesController" as ctrl
end box
box "Backend - MissionControl.Application and Domain" #ECFDF3
  participant "ValidationBehavior" as validation
  participant "ChangeDeliveryModeCommandHandler" as handler
  participant "Workspace" as entity
end box
box "Backend - MissionControl.Infrastructure" #FFF4E5
  database "Mission Control SQL" as db
end box
actor -> page : Project actions > Change delivery mode
page --> actor : ModeChangeDialog names the destination mode and what is kept; focus Cancel
alt Cancel or Escape
  page --> actor : Close dialog; no request; focus returns to Project actions
else Confirm switch
  page -> page : Disable repeat confirmation; show switching progress
  page -> client : Build ChangeDeliveryModeCommand (destination mode, expectedVersion)
  client -> access : PUT /api/workspaces/{id}/mode
  access -> access : L2-002 validate signature, issuer, audience, subject, expiry
  access -> db : Read current status, role and credential version
  db --> access : Current account access
  alt Missing, invalid, or expired JWT; inactive account
    access --> client : 401; audit denial without payloads
    client --> page : Clear in-memory session; require login; mode unchanged
  else Collaborator (profile P: no mode changes)
    access --> client : 403; audit denial without payloads
    client --> page : Close dialog; explain that only administrators change delivery mode
  else Administrator
    access -> ctrl : Authorized request
    ctrl -> validation : Send ChangeDeliveryModeCommand through MediatR 12.5.0
    validation -> validation : Mode is Kanban or Scrum; expectedVersion present
    alt Unknown mode or missing version
      validation --> ctrl : 400 field errors; mode unchanged
      ctrl --> client : Validation ProblemDetails
      client --> page : Show failure with the field message; mode unchanged
    else Valid request
      validation -> handler : Handle ChangeDeliveryModeCommand
      handler -> db : Begin transaction; lock workspace (shared with sprint start and allocation)
      db --> handler : Workspace row or none
      alt Workspace missing
        handler --> ctrl : 404; nothing changed
        ctrl --> client : NotFound ProblemDetails
        client --> page : Close dialog; show "Project not found" with Back to projects
      else Version differs from expectedVersion
        handler --> ctrl : L2-041 409 stale version; nothing changed
        ctrl --> client : Conflict ProblemDetails
        client --> page : Close dialog; reload overview with the current mode; announce that the project changed
      else Current version
        handler -> db : Read active sprint under the same lock
        db --> handler : Active sprint or none
        handler -> entity : L2-027 changeMode(destination, activeSprint)
        alt Active sprint exists
          entity --> handler : Rejected: close the sprint first
          handler --> ctrl : 409 naming the active sprint; nothing changed
          ctrl --> client : Conflict ProblemDetails
          client --> page : Show "Close Sprint N first" with a Close sprint link; Close only; no retry
        else No active sprint
          entity --> handler : Mode set; IDs, statuses, order, assignments, placements, sprints untouched
          handler -> db : L2-039 / L2-040 update Workspace.Mode and version with success audit; one transaction
          alt Commit fails unexpectedly
            db --> handler : Roll back mode and audit
            handler --> ctrl : Generic 500 with correlation ID
            ctrl --> client : Failure; mode unchanged
            client --> page : Keep dialog open; show reference ID; the switch button retries
          else Commit succeeds
            db --> handler : New committed version
            handler --> ctrl : 200 with mode and version
            ctrl --> client : Success response
            client --> page : Close dialog; reload overview tabs and summary for the new mode
            page --> actor : "Now using Kanban" or "Now using Scrum" toast; focus the project heading
          end
        end
      end
    end
  end
end
note over ctrl, db
Kanban mode keeps planned/closed sprints readable but paused;
sprint start and allocation return 409 until Scrum returns (L2-027.3).
Unexpected failures return generic 500 plus correlation ID (L2-043).
end note
@enduml
