@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
title Class structure - Change workspace delivery mode
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
class ProjectOverviewPage {
  +routeContext: Signal<RouteContext>
  +openDialog(): void
}
class ModeChangeDialog {
  +destination: DeliveryMode
  +blockedBy: Signal<SprintReference?>
  +confirm(): void
  +cancel(): void
}
class WorkspaceView {
  +state: Signal<FeatureState>
  +submit(): void
}
interface IWorkspaceService {
  +changeMode(request: ChangeDeliveryModeCommand): Promise<FeatureResult>
}
class WorkspaceService {
  -http: HttpClient
}
class WorkspacesController {
  -sender: ISender
}
class Workspace {
  +id: Guid
  +mode: DeliveryMode
  +version: long
  +changeMode(mode: DeliveryMode, activeSprint: bool): void
}
note right of Workspace
  Writes Mode only. Stories already hold their Kanban
  BoardPlacement (bottom of To Do) from creation,
  so no board backfill runs in either direction.
end note
interface IMissionControlDataSession {
  +query(specification): Task<ReadResult>
  +commit(expectedVersion: long): Task<void>
}
class MissionControlDataSession {
  -connection: DbConnection
}
ProjectOverviewPage --> WorkspaceView : composes
ProjectOverviewPage ..> ModeChangeDialog : opens from Project actions
ModeChangeDialog --> WorkspaceView : composes
WorkspaceView ..> IWorkspaceService : inject token
IWorkspaceService <|.. WorkspaceService
IMissionControlDataSession <|.. MissionControlDataSession
class ChangeDeliveryModeCommand {
  +id: Guid
  +mode: DeliveryMode
  +expectedVersion: long
}
class ChangeDeliveryModeCommandHandler {
  +handle(request: ChangeDeliveryModeCommand): Task<FeatureResult>
}
WorkspacesController ..> ChangeDeliveryModeCommand : dispatches
ChangeDeliveryModeCommandHandler ..> ChangeDeliveryModeCommand : handles
class ActiveSprintProblem {
  +status: 409
  +sprint: SprintReference
}
class SprintReference {
  +sprintId: Guid
  +name: string
}
ActiveSprintProblem *-- SprintReference
ChangeDeliveryModeCommandHandler --> Workspace : loads / applies
ChangeDeliveryModeCommandHandler ..> ActiveSprintProblem : 409 while a sprint is active
ChangeDeliveryModeCommandHandler ..> IMissionControlDataSession : uses

@enduml
