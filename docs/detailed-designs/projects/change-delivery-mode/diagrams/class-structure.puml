}
note bottom of ModeChangeOutcome
  Changed on changed, Outdated on outdated,
  CloseSprint(sprint) on closeSprintRequested;
  no result on Cancel or Escape.
end note
class ModeChangeForm {
  +workspace: InputSignal<WorkspaceDetail>
  +changed: OutputEmitterRef<DeliveryMode>
  +outdated: OutputEmitterRef<void>
  +closeSprintRequested: OutputEmitterRef<SprintReference>
  +unconfirmed: OutputEmitterRef<void>
  +draftChange: OutputEmitterRef<DraftState>
  -submit: WritableSignal<FeatureState>
  -blockedBy: WritableSignal<SprintReference?>
  +confirm(): Promise<void>
}
note right of ModeChangeForm
  Opens blocked, without a request, when the
  workspace input has an active sprint; a 409 after
  Confirm shows the same state. Blocked focuses
  Close Sprint N and is announced as an alert.
  403: dialog stays open; switch unavailable, so
  focus moves to the alert; no reference ID.
  400: field message in the alert; no retry or
  reference ID; switch unavailable, so focus
  moves to the alert.
  500 or 503 (lock wait timed out): failed state,
  previous mode kept; retry only on request.
  404 or stale 409: outdated, and the layout
  calls modeChanged(); it announces the stale
  change only when the reloaded header resolves.
  No response: the failed alert says it couldn't
  confirm the switch (no reference ID); emits
  unconfirmed. A resent switch that meets the
  stale 409 emits outdated as above.
end note
interface IWorkspaceService {
  +changeMode(command: ChangeDeliveryModeCommand): Promise<void>
}
