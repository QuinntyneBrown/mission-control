  -http: HttpClient
}
class WorkspacesController {
  -sender: ISender
}
class Workspace {
  +id: Guid
  +mode: DeliveryMode
  +version: long
  +changeMode(mode: DeliveryMode, activeSprint: bool): void
}
note right of Workspace
  Writes Mode only. Stories already hold their Kanban
  BoardPlacement (bottom of To Do) from creation,
  so no board backfill runs in either direction.
end note
interface IMissionControlDataSession {
  +BeginWorkspaceTransactionAsync(workspaceId: Guid, ct: CancellationToken): Task
  +LoadWorkspaceAsync(id: Guid, ct: CancellationToken): Task<Workspace?>
  +LoadActiveSprintAsync(workspaceId: Guid, ct: CancellationToken): Task<SprintReference?>
  +AddAuditEvent(auditEvent: AuditEvent): void
  +SaveChangesAsync(ct: CancellationToken): Task
}
note bottom of IMissionControlDataSession
  Scoped view of the shared port; only the members this
  slice uses. The workspace lock is taken first and held
  only until SaveChangesAsync commits. A lock-wait
  timeout maps to 503 with Retry-After, nothing changed.
end note
class MissionControlDataSession
ProjectLayoutPage --> ProjectHeaderView : composes; inputs and outputs only
ProjectLayoutPage ..> IToastService : inject TOAST_SERVICE
ProjectHeaderView ..> WorkspaceActionKind : emits
ProjectLayoutPage ..> ModeChangeDialog : opens through openDialog(ChangeMode);\ncalls modeChanged() on Changed or Outdated
ProjectOverviewPage --> WorkspaceOverviewView : composes; relays changeModeRequested
ProjectOverviewPage ..> ProjectLayoutPage : openDialog(ChangeMode)
WorkspaceForm ..> ProjectLayoutPage : via ProjectFormDialog's ChangeMode close result
ModeChangeDialog --> ModeChangeForm : hosts; inputs and outputs only
ModeChangeDialog ..> ModeChangeOutcome : close result
FormDraft <|.. ModeChangeDialog
FormDraft <|.. ProjectLayoutPage
ModeChangeForm ..> DraftState : emits
ModeChangeForm ..> IWorkspaceService : inject WORKSPACE_SERVICE
IWorkspaceService <|.. WorkspaceService
IMissionControlDataSession <|.. MissionControlDataSession
