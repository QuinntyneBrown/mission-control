  +sprintId: Guid
  +name: string
}
ActiveSprintProblem *-- SprintReference
ChangeDeliveryModeCommandHandler --> Workspace : loads / applies
ChangeDeliveryModeCommandHandler ..> ActiveSprintProblem : 409 while a sprint is active
ChangeDeliveryModeCommandHandler ..> IMissionControlDataSession : locks; loads; AddAuditEvent; SaveChangesAsync

enum DeliveryMode {
  Kanban
  Scrum
}
Workspace --> DeliveryMode
