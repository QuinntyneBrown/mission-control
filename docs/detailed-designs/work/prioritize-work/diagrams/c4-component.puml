@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components - Prioritize siblings and the story backlog
Container(web, "Mission Control web client", "Angular", "BacklogView, MovePositionForm, and sibling Move up / Move down in WorkHierarchyBranch")
ContainerDb(db, "Mission Control database", "SQL", "Versioned feature records and audit events")
Container_Boundary(api, "MissionControl.Api runtime") {
  Component(ctrl, "WorkOrdersController", "API boundary", "Binds request and dispatches through MediatR 12.5.0")
  Component(access, "CurrentAccountAuthorization", "API authentication / authorization", "Validates JWT and checks current SQL account access")
  Component(validation, "ValidationBehavior", "Application pipeline", "Invokes request validators")
  Component(entity, "WorkOrder", "Domain", "One order set: ordered stable IDs and order version")
  Component(store, "MissionControlDataSession", "Infrastructure", "Implements IMissionControlDataSession: workspace transaction and lock, typed order queries, SaveChangesAsync")
Rel(web, access, "Calls through IWorkOrderService / WorkOrderService", "HTTPS")
Rel(access, db, "Checks current access for protected requests", "SQL")
Rel(access, ctrl, "Forwards authenticated request")
Rel(ctrl, validation, "Sends typed request")
Component(h0, "ReorderSiblingCommandHandler", "Application / MediatR", "Reorder siblings")
Rel(validation, h0, "Dispatches validated request")
Rel(h0, entity, "Reads / applies domain behavior")
Rel(h0, store, "Loads / persists state")
Component(h1, "PrioritizeStoryCommandHandler", "Application / MediatR", "Prioritize a story across epics")
Rel(validation, h1, "Dispatches validated request")
Rel(h1, entity, "Reads / applies domain behavior")
Rel(h1, store, "Loads / persists state")
Component(h2, "ListBacklogQueryHandler", "Application / MediatR", "Read bounded backlog and full priority count")
Rel(validation, h2, "Dispatches validated request")
Rel(h2, entity, "Reads / applies domain behavior")
Rel(h2, store, "Loads / persists state")
}
Rel(store, db, "Bounded backlog reads without descriptions; interval rewrites under the lock", "SQL")
@enduml
