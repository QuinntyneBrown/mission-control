@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components - Create and navigate the work hierarchy
Container(web, "Mission Control web client", "Angular", "Work pages and WorkItemFormDialog; WorkHierarchyView and WorkHierarchyBranch, WorkListView, WorkItemDetailView, WorkItemForm; ResourceRef reads")
ContainerDb(db, "Mission Control database", "SQL", "Versioned feature records and audit events")
Container_Boundary(api, "MissionControl.Api runtime") {
  Component(ctrl, "WorkItemsController", "API boundary", "Binds request and dispatches through MediatR 12.5.0")
  Component(access, "CurrentAccountAuthorization", "API authentication / authorization", "Validates JWT and checks current SQL account access")
  Component(validation, "ValidationBehavior", "Application pipeline", "Invokes request validators")
  Component(entity, "WorkItem", "Domain", "Hierarchy level, parent rule, status, and version")
  Component(store, "MissionControlDataSession", "Infrastructure", "Implements IMissionControlDataSession: workspace transaction and lock, typed work-item queries, SaveChangesAsync")
Rel(web, access, "Calls through IWorkItemService / WorkItemService", "HTTPS")
Rel(access, db, "Checks current access for protected requests", "SQL")
Rel(access, ctrl, "Forwards authenticated request")
Rel(ctrl, validation, "Sends typed request")
Component(h0, "CreateWorkItemCommandHandler", "Application / MediatR", "Create a typed child or initiative")
Rel(validation, h0, "Dispatches validated request")
Rel(h0, entity, "Reads / applies domain behavior")
Rel(h0, store, "Loads / persists state")
Component(h1, "GetWorkItemsQueryHandler", "Application / MediatR", "Read hierarchy batches and filtered lists with the parent's order version")
Rel(validation, h1, "Dispatches validated request")
Rel(h1, store, "Reads one bounded page of summaries")
Component(h2, "GetWorkItemQueryHandler", "Application / MediatR", "Read one item's detail, path, and sibling position")
Rel(validation, h2, "Dispatches validated request")
Rel(h2, entity, "Resolves the ancestor path")
Rel(h2, store, "Reads the item detail")
}
Rel(store, db, "Bounded summary reads without descriptions; atomic writes", "SQL")
@enduml
