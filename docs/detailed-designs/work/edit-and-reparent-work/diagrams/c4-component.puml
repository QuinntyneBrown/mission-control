@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components - Edit, assign, and reparent work
Container(web, "Mission Control web client", "Angular", "WorkItemForm, ReparentForm; IWorkItemService and IAssigneeService adapters")
ContainerDb(db, "Mission Control database", "SQL", "Versioned feature records, user accounts, and audit events")
Container_Boundary(api, "MissionControl.Api runtime") {
  Component(ctrl, "WorkItemsController", "API boundary", "Binds request and dispatches through MediatR 12.5.0")
  Component(choices, "AssigneeChoicesController", "API boundary", "Binds the assignee search and dispatches through MediatR 12.5.0")
  Component(access, "CurrentAccountAuthorization", "API authentication / authorization", "Validates JWT and checks current SQL account access")
  Component(validation, "ValidationBehavior", "Application pipeline", "Invokes request validators")
  Component(entity, "WorkItem", "Domain", "Editable fields, assignment, parent link, and version")
  Component(store, "MissionControlDataSession", "Infrastructure", "Implements IMissionControlDataSession: workspace transaction and lock, typed work-item and assignee queries, SaveChangesAsync")
Rel(web, access, "Calls through IWorkItemService / WorkItemService and IAssigneeService / AssigneeService", "HTTPS")
Rel(access, db, "Checks current access for protected requests", "SQL")
Rel(access, ctrl, "Forwards authenticated request")
Rel(access, choices, "Forwards any authenticated active role")
Rel(ctrl, validation, "Sends typed request")
Rel(choices, validation, "Sends ListAssigneeChoicesQuery")
Component(h0, "UpdateWorkItemCommandHandler", "Application / MediatR", "Edit fields, assignment, dates, and status")
Rel(validation, h0, "Dispatches validated request")
Rel(h0, entity, "Applies validated edits")
Rel(h0, store, "Locks workspace, loads, and saves")
Component(h2, "ListAssigneeChoicesQueryHandler", "Application / MediatR", "Active accounts as ID and display name, paged")
Rel(validation, h2, "Dispatches validated request")
Rel(h2, store, "Reads one page of active accounts")
Component(h1, "ReparentWorkItemCommandHandler", "Application / MediatR", "Move item to another valid parent")
Rel(validation, h1, "Dispatches validated request")
Rel(h1, entity, "Changes the parent link")
Rel(h1, store, "Locks workspace, loads, and saves")
}
Rel(store, db, "Bounded reads; atomic writes", "SQL")
@enduml
