@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
title Behavior - Edit fields, assignment, dates, and status
actor "Authorized user" as actor
box "Frontend - Mission Control application" #E0F2FE
  participant "WorkItemDetailPage / WorkItemFormDialog / WorkItemView" as page
  participant "UnfinishedTasksDialog" as dialog
  participant "IWorkItemService / WorkItemService" as client
end box
box "Backend - MissionControl.Api" #D1FADF
  participant "CurrentAccountAuthorization" as access
  participant "WorkItemsController" as ctrl
end box
box "Backend - MissionControl.Application and Domain" #ECFDF3
  participant "ValidationBehavior" as validation
  participant "UpdateWorkItemCommandHandler" as handler
  participant "WorkItem" as entity
end box
box "Backend - MissionControl.Infrastructure" #FFF4E5
  database "Mission Control SQL" as db
end box
actor -> page : Edit fields, assignment, dates, or status and save
page -> page : Disable Save while pending (L2-031)
page -> client : Build typed UpdateWorkItemCommand (explicit nulls for cleared fields, expected item version)
client -> access : PUT /api/workspaces/{id}/work-items/{itemId}
access -> access : L2-002 validate signature, issuer, audience, subject, expiry
access -> db : Read current status, role and credential version
db --> access : Current account access
alt Missing, invalid or expired JWT; deactivated account
  access --> client : 401; audit denial without payloads
  client --> page : Clear session; sign in with the item as return route
else Authenticated without permission to update work
  access --> client : 403; audit denial without payloads
  client --> page : Keep input; explain that editing work is not permitted
else Authorized
  access -> ctrl : Authorized request
  ctrl -> validation : Send UpdateWorkItemCommand through MediatR 12.5.0
  validation -> validation : L2-016 title 1-200, description up to 10,000, known status, due on or after start, whole estimate of 0 or more for stories only
  alt Invalid fields
    validation --> ctrl : 400 field errors; nothing read or changed
    ctrl --> client : Validation ProblemDetails
    client --> page : Keep valid input; focus the linked error summary (validation state)
  else Valid request
    validation -> handler : Handle UpdateWorkItemCommand
    handler -> db : Lock workspace; load item and version, chosen assignee status, story completion condition
    db --> handler : Current item and reference state
    alt Workspace or item not found
      handler --> ctrl : 404; nothing changed
      ctrl --> client : ProblemDetails (not found)
      client --> page : Close the form; detail shows its not-found state with links to the project and Projects
    else Stale item version (L2-041)
      handler --> ctrl : 409 stale version; nothing changed
      ctrl --> client : ProblemDetails (changed)
      client -> client : Read the latest version once; never resubmit
      client --> page : Keep attempted values; compare "Your edit" with "Latest saved" (conflict state)
      opt Reload latest
        actor -> page : Reload latest
        page -> page : Adopt latest values and version; comparison stays visible; Save enabled (conflict-reloaded state)
      end
    else Newly chosen assignee inactive or unknown
      handler --> ctrl : 400 invalid assignee; nothing changed
      ctrl --> client : Validation ProblemDetails (assignee field)
      client --> page : Keep input; assignee field error (rejected state)
    else Story set to Done with unfinished tasks; condition absent or not current
      handler -> handler : L2-021 StoryCompletionPolicy: sent condition missing or not current
      handler --> ctrl : 409 unfinished-tasks with count and StoryCompletionCondition; nothing changed
      ctrl --> client : ProblemDetails (unfinished-tasks)
      client --> page : Keep the edit; hold the returned condition
      page -> dialog : Open with story title and unfinished count; focus Keep in progress
      alt Mark story Done
        dialog --> page : Confirmed
        page -> client : Resubmit the same UpdateWorkItemCommand with the returned condition
        note right of client : Re-enters this flow; a changed count returns a new 409 and the dialog shows server-count
      else Keep in progress
        dialog --> page : Kept
        page -> page : Restore the saved status; send no request; focus returns to Status
      end
    else Edit permitted
      handler -> entity : L2-016 apply validated fields; keep an unchanged inactive assignee; type and workspace unchanged
      entity --> handler : Updated details
      handler -> db : L2-039 / L2-040 update item, live board placements on a status change, and success audit in one transaction
      alt Commit fails
        db --> handler : Roll back business state and success audit
        handler --> ctrl : Generic 500 with correlation ID
        ctrl --> client : Failure; no successful-save claim
        client --> page : Keep every value; show reference ID; Save retries the same request (failed state)
      else Commit succeeds
        db --> handler : New item version
        handler --> ctrl : Updated item
        ctrl --> client : 200 with new version
        client --> page : Close the form; update every view's signal state
        page --> actor : Announce "Changes saved"; focus returns to Edit
      end
    end
  end
end
note over ctrl, db
Checks run in this order under the lock, before any write: item exists, version current, assignee active, completion condition.
Unexpected failures return generic 500 plus correlation ID (L2-043).
Diagnostics exclude secrets and contact payloads.
end note
@enduml
