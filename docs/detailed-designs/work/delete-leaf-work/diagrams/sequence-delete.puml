@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
title Behavior - Delete a confirmed leaf item
actor "Authorized user" as actor
box "Frontend - Mission Control application" #E0F2FE
  participant "WorkItemDetailPage / WorkItemDeleteDialog / WorkItemView" as page
  participant "IWorkItemService / WorkItemService" as client
end box
box "Backend - MissionControl.Api" #D1FADF
  participant "CurrentAccountAuthorization" as access
  participant "WorkItemsController" as ctrl
end box
box "Backend - MissionControl.Application and Domain" #ECFDF3
  participant "ValidationBehavior" as validation
  participant "DeleteWorkItemCommandHandler" as handler
  participant "WorkItem" as entity
end box
box "Backend - MissionControl.Infrastructure" #FFF4E5
  database "Mission Control SQL" as db
end box
actor -> page : Choose Delete on a work item
page -> page : Open the confirmation naming the item; focus Cancel
alt Cancel or Escape
  actor -> page : Cancel
  page -> page : Close; send no request; focus returns to Delete
else Confirm
  actor -> page : Delete
  page -> page : Disable both buttons while pending (deleting state)
  page -> client : Build typed DeleteWorkItemCommand (workspace and item IDs; no version)
  client -> access : DELETE /api/workspaces/{id}/work-items/{itemId}
  access -> access : L2-002 validate signature, issuer, audience, subject, expiry
  access -> db : Read current status, role and credential version
  db --> access : Current account access
  alt Missing, invalid or expired JWT; deactivated account
    access --> client : 401; audit denial without payloads
    client --> page : Clear session; sign in with the item as return route
  else Collaborator (profile P: only administrators delete work)
    access --> client : 403; audit denial without payloads
    client --> page : Close the dialog; Delete stays unavailable with its written reason
  else Administrator
    access -> ctrl : Authorized request
    ctrl -> validation : Send DeleteWorkItemCommand through MediatR 12.5.0
    validation -> validation : Identifiers present and well formed
    alt Malformed identifiers
      validation --> ctrl : 400; nothing read or changed
      ctrl --> client : Validation ProblemDetails
      client --> page : Show the message; nothing deleted
    else Valid request
      validation -> handler : Handle DeleteWorkItemCommand
      handler -> db : Lock workspace; load item, child count, and open sprint membership
      db --> handler : Current deletion conditions
      alt Workspace or item not found
        handler --> ctrl : 404; nothing changed
        ctrl --> client : ProblemDetails (not found)
        client --> page : Close the dialog; reload the list without the item; announce it was already deleted
      else Item has children (L2-018.1)
        handler --> ctrl : 409 has-children with child count; nothing changed
        ctrl --> client : ProblemDetails (blocked)
        client --> page : Explain moving or deleting the children first; Close only, no retry (has-children state)
      else Story in a planned or active sprint (L2-018.2)
        handler --> ctrl : 409 open-sprint membership naming the sprint; nothing changed
        ctrl --> client : ProblemDetails (blocked)
        client --> page : Explain removing it from the sprint first; offer the sprint scope action, no retry (in-sprint state)
      else Deletable leaf
        handler -> entity : L2-018 confirm leaf outside open membership
        entity --> handler : Permitted deletion
        handler -> db : L2-039 / L2-040 delete item; compact siblings; for a story remove and compact its backlog position and board placements; bump order versions; success audit
        note right of db : Closed SprintStoryOutcome rows have no cascading FK and stay unchanged (L2-018.4)
        alt Commit fails
          db --> handler : Roll back business state and success audit
          handler --> ctrl : Generic 500 with correlation ID
          ctrl --> client : Failure; no deletion claim
          client --> page : Nothing deleted; show reference ID; Try again resends the same request (failed state)
        else Commit succeeds
          db --> handler : Committed deletion
          handler --> ctrl : Deleted
          ctrl --> client : 204
          client --> page : Close the dialog; remove the item from every view; refresh counts
          page --> actor : Announce the deletion; focus moves to the parent or the list heading
        end
      end
    end
  end
end
note over ctrl, db
All rejection checks run under the lock before any write.
Unexpected failures return generic 500 plus correlation ID (L2-043).
Diagnostics exclude secrets and contact payloads.
end note
@enduml
