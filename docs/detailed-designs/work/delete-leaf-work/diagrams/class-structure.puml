@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
title Class structure - Delete permitted leaf work
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
class WorkItemDetailPage {
  +routeContext: Signal<RouteContext>
  +openDialog(): void
}
class WorkItemDeleteDialog {
  +itemName: string
  +blocker: Signal<DeletionBlocker?>
  +confirm(): void
}
class WorkItemView {
  +state: Signal<FeatureState>
  +submit(): void
}
interface IWorkItemService {
  +delete(request: DeleteWorkItemCommand): Promise<FeatureResult>
}
class WorkItemService {
  -http: HttpClient
}
class WorkItemsController {
  -sender: ISender
}
class WorkItem {
  +id: Guid
  +workspaceId: Guid
  +parentId: Guid?
  +type: WorkItemType
  +title: string
  +description: string?
  +status: WorkStatus
  +siblingPosition: int
  +assigneeId: Guid?
  +startDate: DateOnly?
  +dueDate: DateOnly?
  +storyEstimate: int?
  +version: long
  +checkDeletion(hasChildren: bool, inOpenSprint: bool): void
}
interface IMissionControlDataSession {
  +query(specification): Task<ReadResult>
  +commit(expectedVersion: long): Task<void>
}
class MissionControlDataSession {
  -connection: DbConnection
}
WorkItemDetailPage --> WorkItemView : composes
WorkItemDetailPage ..> WorkItemDeleteDialog : opens
WorkItemDeleteDialog --> WorkItemView : composes
WorkItemView ..> IWorkItemService : inject token
IWorkItemService <|.. WorkItemService
IMissionControlDataSession <|.. MissionControlDataSession
class DeleteWorkItemCommand {
  +workspaceId: Guid
  +itemId: Guid
}
class DeleteWorkItemCommandHandler {
  +handle(request: DeleteWorkItemCommand): Task<FeatureResult>
}
WorkItemsController ..> DeleteWorkItemCommand : dispatches
DeleteWorkItemCommandHandler ..> DeleteWorkItemCommand : handles
DeleteWorkItemCommandHandler --> WorkItem : loads / applies
DeleteWorkItemCommandHandler ..> IMissionControlDataSession : uses

enum WorkItemType {
  Initiative
  Epic
  Story
  Task
}
enum WorkStatus {
  ToDo
  InProgress
  Done
}
WorkItem --> WorkItemType : immutable level
WorkItem --> WorkStatus : current status
WorkItem "0..1" <-- "*" WorkItem : parent / children
@enduml
