@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
title Class structure - Confirm story completion with unfinished tasks
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
class WorkItemDetailPage {
  +routeContext: Signal<RouteContext>
  +openDialog(): void
}
class MoveStoryDialog {
  +destination: Signal<WorkStatus>
  +position: Signal<int>
  +move(): void
}
class UnfinishedTasksDialog {
  +storyTitle: string
  +unfinishedCount: int
  +keep(): void
  +markDone(): void
}
note bottom of UnfinishedTasksDialog
  KanbanBoardPage and SprintBoardPage also open it
  when a Done move returns 409 unfinished-tasks.
end note
class WorkItemView {
  +state: Signal<FeatureState>
  +submit(): void
}
interface IWorkItemService {
  +complete(request: CompleteStoryCommand): Promise<FeatureResult>
}
class WorkItemService {
  -http: HttpClient
}
class WorkItemsController {
  -sender: ISender
}
class StoryCompletionCondition {
  +storyId: Guid
  +storyVersion: long
  +taskRevision: long
  +unfinishedCount: int
  +matches(current: StoryCompletionCondition): bool
}
interface IMissionControlDataSession {
  +query(specification): Task<ReadResult>
  +commit(expectedVersion: long): Task<void>
}
class MissionControlDataSession {
  -connection: DbConnection
}
WorkItemDetailPage --> WorkItemView : composes
WorkItemDetailPage --> UnfinishedTasksDialog : opens on 409 unfinished-tasks
MoveStoryDialog ..> UnfinishedTasksDialog : a refused Done move leads to
UnfinishedTasksDialog ..> StoryCompletionCondition : shows count; returns it on Mark story Done
WorkItemView ..> IWorkItemService : inject token
IWorkItemService <|.. WorkItemService
IMissionControlDataSession <|.. MissionControlDataSession
class CompleteStoryCommand {
  +workspaceId: Guid
  +storyId: Guid
  +expectedStoryVersion: long
  +completionCondition: StoryCompletionCondition?
}
class CompleteStoryCommandHandler {
  +handle(request: CompleteStoryCommand): Task<FeatureResult>
}
WorkItemsController ..> CompleteStoryCommand : dispatches
CompleteStoryCommandHandler ..> CompleteStoryCommand : handles
CompleteStoryCommandHandler --> StoryCompletionCondition : loads / applies
CompleteStoryCommandHandler ..> IMissionControlDataSession : uses

@enduml
