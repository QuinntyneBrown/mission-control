@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components - Confirm story completion with unfinished tasks
Container(web, "Mission Control web client", "Angular", "WorkItemDetailPage, UnfinishedTasksDialog / WorkItemDetailView")
ContainerDb(db, "Mission Control database", "SQL", "Versioned feature records and audit events")
Container_Boundary(api, "MissionControl.Api runtime") {
  Component(ctrl, "WorkItemsController", "API boundary", "Binds request and dispatches through MediatR 12.5.0")
  Component(access, "CurrentAccountAuthorization", "API authentication / authorization", "Validates JWT and checks current SQL account access")
  Component(validation, "ValidationBehavior", "Application pipeline", "Invokes request validators")
  Component(transition, "StoryStatusTransition", "Application service", "Shared with moves and story edits; sets status on every live placement and bumps the active sprint's version")
  Component(entity, "StoryCompletionPolicy", "Domain", "Compares the sent StoryCompletionCondition with the current one")
  Component(store, "MissionControlDataSession", "Infrastructure", "Implements the Application data port; workspace lock, version checks, commit")
Rel(web, access, "Calls through IWorkItemService / WorkItemService", "HTTPS")
Rel(access, db, "Checks current access for protected requests", "SQL")
Rel(access, ctrl, "Forwards authorized request")
Rel(ctrl, validation, "Sends typed request")
Component(h0, "CompleteStoryCommandHandler", "Application / MediatR", "Confirm current unfinished-task condition")
Rel(validation, h0, "Dispatches validated request")
Rel(h0, transition, "Changes the story status through")
Rel(transition, entity, "Checks before any change")
Rel(h0, store, "Locks the workspace; loads the condition; saves the story")
}
Rel(store, db, "Task-count aggregate; locked, versioned atomic write", "SQL")
@enduml
