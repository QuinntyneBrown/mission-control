@startuml
!include <C4/C4_Container>
LAYOUT_WITH_LEGEND()
title Containers - Move and reorder story cards
Person(actor, "Authorized user", "Move and reorder story cards")
System_Boundary(mc, "Mission Control") {
  Container(web, "Mission Control web client", "Angular", "Move and reorder story cards")
  Container(api, "MissionControl.Api", ".NET", "Authorized placement command")
  ContainerDb(db, "Mission Control database", "SQL - provider <TO SUPPLY>", "BoardState, BoardPlacement, stories and audit events")
}
Rel(actor, web, "Uses")
Rel(web, api, "One pending move per board; re-reads affected columns", "HTTPS / JSON")
Rel(api, db, "Commits placement, status and audit atomically", "Parameterized SQL")
@enduml
