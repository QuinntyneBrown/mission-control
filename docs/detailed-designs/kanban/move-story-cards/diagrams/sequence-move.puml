@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
title Behavior - Move by drag or labeled controls
actor "Authorized user" as actor
box "Frontend - Mission Control application" #E0F2FE
  participant "KanbanBoardPage / BoardView" as page
  participant "UnfinishedTasksDialog" as dialog
  participant "IBoardService / BoardService" as client
end box
box "Backend - MissionControl.Api" #D1FADF
  participant "CurrentAccountAuthorization" as access
  participant "BoardsController" as ctrl
end box
box "Backend - MissionControl.Application and Domain" #ECFDF3
  participant "ValidationBehavior" as validation
  participant "MoveStoryCommandHandler" as handler
  participant "BoardPlacement" as entity
end box
box "Backend - MissionControl.Infrastructure" #FFF4E5
  database "Mission Control SQL" as db
end box
actor -> page : Drop a card, or choose a destination in MoveStoryDialog or Move up/down
page -> page : Snapshot saved board; show card Saving at the destination; keep committed column totals
page -> client : Build typed MoveStoryCommand (destination, position, story and board versions)
client -> access : PUT /api/workspaces/{id}/board/stories/{storyId}/placement
access -> access : L2-002 validate signature, issuer, audience, subject, expiry
access -> db : Read current status, role and credential version
db --> access : Current account access
alt Missing, invalid or expired JWT; deactivated account
  access --> client : 401; audit denial without payloads
  client --> page : Restore snapshot; clear session; sign in with the board as return route
else Authenticated without permission to move cards
  access --> client : 403; audit denial without payloads
  client --> page : Restore snapshot; explain that the move is not permitted
else Authorized
  access -> ctrl : Authorized request
  ctrl -> validation : Send MoveStoryCommand through MediatR 12.5.0
  validation -> validation : L2-020 validate status, position and identifiers
  alt Unknown status or malformed position
    validation --> ctrl : 400 field errors; nothing read or changed
    ctrl --> client : Validation ProblemDetails
    client --> page : Restore snapshot; MoveStoryDialog keeps choices and shows the message; a drag shows the failure toast
  else Valid request
    validation -> handler : Handle MoveStoryCommand
    handler -> db : Lock workspace order boundary; load story, board, live placements, versions, completion condition
    db --> handler : Persisted status, order, versions and task condition
    alt Workspace or story not found
      handler --> ctrl : 404; nothing changed
      ctrl --> client : ProblemDetails (not found)
      client --> page : Missing story: reload board without it and announce; missing workspace: not-found state linking to Projects
    else Board or position outside the story's workspace or column bounds
      handler --> ctrl : 400 invalid reference; nothing changed
      ctrl --> client : Validation ProblemDetails
      client --> page : Restore snapshot; explain why the move was refused; offer Retry
    else Stale story or board version; story left the sprint; delivery mode changed
      handler --> ctrl : 409 conflict; nothing changed
      ctrl --> client : ProblemDetails (board changed)
      client --> page : Restore snapshot; "The board changed" alert; Reload board reads the latest columns without resubmitting
    else Done with unfinished tasks; condition absent or no longer current
      handler -> handler : L2-021 StoryCompletionPolicy: sent condition missing or not current
      handler --> ctrl : 409 unfinished-tasks with count and StoryCompletionCondition; nothing changed
      ctrl --> client : ProblemDetails (unfinished-tasks)
      client --> page : Keep snapshot; hold returned condition
      page -> dialog : Open with story title and returned count; focus Keep in progress
      alt Mark story Done
        dialog --> page : Confirmed
        page -> client : Resubmit the same MoveStoryCommand (same destination and position) with the returned condition
        note right of client : Re-enters this flow; a changed count returns a new 409 and the dialog shows server-count
      else Keep in progress
        dialog --> page : Kept
        page -> page : Restore snapshot; send no request; focus returns to the card's Move button
      end
    else Move permitted
      handler -> entity : L2-020 place story; synchronize status on every live placement
      entity --> handler : Requested placement; compacted source; appended placements on other boards
      handler -> db : L2-039 / L2-040 update story, placements, board versions and success audit in one transaction
      alt Commit fails
        db --> handler : Roll back business state and success audit
        handler --> ctrl : Generic 500 with correlation ID
        ctrl --> client : Failure; no successful-save claim
        client --> page : Restore snapshot; "Couldn't move story" toast with Retry; MoveStoryDialog shows the reference ID
      else Commit succeeds
        db --> handler : New story and board versions
        handler --> ctrl : Committed placement
        ctrl --> client : 200 with placement and versions
        client --> page : Replace snapshot with committed board
        page --> actor : Announce destination and position
      end
    end
  end
end
note over ctrl, db
Unexpected failures return generic 500 plus correlation ID (L2-043).
No response (uncertain outcome): reload story and board before offering Retry.
Diagnostics exclude secrets and contact payloads.
end note
@enduml
