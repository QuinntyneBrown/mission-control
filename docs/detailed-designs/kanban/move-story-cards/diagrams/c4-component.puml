@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components - Move and reorder story cards
Container(web, "Mission Control web client", "Angular", "KanbanBoardPage, MoveStoryDialog, UnfinishedTasksDialog / BoardView")
ContainerDb(db, "Mission Control database", "SQL", "Versioned feature records and audit events")
Container_Boundary(api, "MissionControl.Api runtime") {
  Component(ctrl, "BoardsController", "API boundary", "Binds request and dispatches through MediatR 12.5.0")
  Component(access, "CurrentAccountAuthorization", "API authentication / authorization", "Validates JWT and checks current SQL account access")
  Component(validation, "ValidationBehavior", "Application pipeline", "Invokes request validators")
  Component(transition, "StoryStatusTransition", "Application service", "Applies StoryCompletionPolicy; moves every live placement; bumps the active sprint's version")
  Component(entity, "BoardPlacement", "Domain", "One story's status and position on one board")
  Component(store, "MissionControlDataSession", "Infrastructure", "Implements the Application data port; workspace lock, version checks, commit")
Rel(web, access, "Moves through IBoardService.move; re-reads through boardResource", "HTTPS")
Rel(access, db, "Checks current access for protected requests", "SQL")
Rel(access, ctrl, "Forwards authorized request")
Rel(ctrl, validation, "Sends typed request")
Component(h0, "MoveStoryCommandHandler", "Application / MediatR", "Move by drag or labeled controls")
Rel(validation, h0, "Dispatches validated request")
Rel(h0, transition, "Status changes")
Rel(h0, entity, "Same-column reorder")
Rel(transition, entity, "Places the story; synchronizes live placements")
Rel(h0, store, "Locks the workspace; loads and saves placements")
}
Rel(store, db, "Locked, versioned atomic write", "SQL")
@enduml
