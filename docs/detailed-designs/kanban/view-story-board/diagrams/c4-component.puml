@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components - View the Kanban story board
Container(web, "Mission Control web client", "Angular", "KanbanBoardPage, WorkItemFormDialog / BoardView")
ContainerDb(db, "Mission Control database", "SQL", "Stories, board placements and tasks")
Container_Boundary(api, "MissionControl.Api runtime") {
  Component(ctrl, "BoardsController", "API boundary", "Binds request and dispatches through MediatR 12.5.0")
  Component(access, "CurrentAccountAuthorization", "API authentication / authorization", "Validates JWT and checks current SQL account access")
  Component(validation, "ValidationBehavior", "Application pipeline", "Invokes request validators")
  Component(entity, "BoardCard", "Application read projection", "Title, assignee, status, position and task counts; no description")
  Component(store, "MissionControlDataSession", "Infrastructure", "Implements the Application data port; typed board reads")
Rel(web, access, "Reads through boardResource (IBoardService / BoardService)", "HTTPS")
Rel(access, db, "Checks current access for protected requests", "SQL")
Rel(access, ctrl, "Forwards authorized request")
Rel(ctrl, validation, "Sends typed request")
Component(h0, "GetKanbanBoardQueryHandler", "Application / MediatR", "Read story columns and task counts")
Rel(validation, h0, "Dispatches validated request")
Rel(h0, entity, "Projects cards")
Rel(h0, store, "Reads column batches, full counts and task counts")
}
Rel(store, db, "Bounded column batches; set-based task-count aggregate", "SQL")
@enduml
