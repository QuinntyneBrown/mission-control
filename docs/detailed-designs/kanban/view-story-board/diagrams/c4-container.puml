@startuml
!include <C4/C4_Container>
LAYOUT_WITH_LEGEND()
title Containers - View the Kanban story board
Person(actor, "Authorized user", "View the Kanban story board")
System_Boundary(mc, "Mission Control") {
  Container(web, "Mission Control web client", "Angular", "View the Kanban story board")
  Container(api, "MissionControl.Api", ".NET", "Authorized board read")
  ContainerDb(db, "Mission Control database", "SQL - provider <TO SUPPLY>", "Stories, board placements and tasks")
}
Rel(actor, web, "Uses")
Rel(web, api, "Reads board batches", "HTTPS / JSON")
Rel(api, db, "Reads board records", "Parameterized SQL")
@enduml
