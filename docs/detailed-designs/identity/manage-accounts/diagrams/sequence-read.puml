@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
title Behavior - Read account directory and details
actor "Administrator" as actor
box "Frontend - Mission Control application" #E0F2FE
  participant "AccountsPage / AccountDetailPage / AccountView" as page
  participant "IAccountService / AccountService" as client
end box
box "Backend - MissionControl.Api" #D1FADF
  participant "CurrentAccountAuthorization" as access
  participant "AccountsController" as ctrl
end box
box "Backend - MissionControl.Application and Domain" #ECFDF3
  participant "ValidationBehavior" as validation
  participant "GetAccountQueryHandler" as handler
  participant "UserAccount" as entity
end box
box "Backend - MissionControl.Infrastructure" #FFF4E5
  participant "IAuditEventWriter" as audit
  database "Mission Control SQL" as db
end box
actor -> page : Open /accounts or /accounts/:id
page -> page : Show loading skeleton
page -> client : Build typed GetAccountQuery (id, or page and pageSize)
client -> access : GET /api/accounts[/{id}]
access -> access : L2-002 validate signature, issuer, audience, subject, expiry (zero clock skew)
access -> db : Read current status, role and credential version
db --> access : Current account access
alt Missing, invalid or expired JWT; inactive or missing account; credential version changed
  access -> audit : Append Denied audit (restricted append; no payload)
  access --> client : 401
  client --> page : Clear in-memory session; open login (session-ended) with this route to return to
else Authenticated Collaborator (profile P: no account management)
  access -> audit : Append Denied audit (restricted append; no payload)
  access --> client : 403
  client --> page : Show access-denied page; no account data shown
else Administrator
  access -> ctrl : Authorized request
  ctrl -> validation : Send GetAccountQuery through MediatR 12.5.0
  validation -> validation : L2-045 page at least 1; pageSize 1-100 (default 25)
  alt Invalid page or page size
    validation --> ctrl : 400 field errors; nothing read
    ctrl --> client : Validation ProblemDetails
    client --> page : Error state with the message; Try again reloads page 1 at 25 rows
  else Valid request
    validation -> handler : Handle GetAccountQuery
    handler -> db : Read one account by ID, or a bounded page ordered by name then ID with total count
    db --> handler : Rows and total, or no row
    alt Requested account ID not found
      handler --> ctrl : 404; nothing read
      ctrl --> client : NotFound ProblemDetails
      client --> page : not-found state with a link back to Accounts
    else Records found
      handler -> entity : Project safe summaries; exclude password hash and credential material
      entity --> handler : Names, email, role, active, version, designated flag
      handler --> ctrl : 200 with summaries and full matching count
      ctrl --> client : Success response
      client --> page : Update signals; designated account shows protected status
      page --> actor : Accounts list or details; focus the page heading
    end
  end
end
note over ctrl, db
Unexpected failures return generic 500 plus correlation ID (L2-043);
Accounts shows its error state with the reference ID and Try again.
Diagnostics exclude secrets and contact payloads.
end note
@enduml
