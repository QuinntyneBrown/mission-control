@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
title Behavior - Read account directory and details
skinparam maxMessageSize 300
actor "Administrator" as actor
box "Frontend - Mission Control application" #E0F2FE
  participant "AccountsPage / AccountView, or\nAccountDetailPage / AccountDetailView" as page
  participant "IAccountService / AccountService" as client
end box
box "Backend - MissionControl.Api" #D1FADF
  participant "CurrentAccountAuthorization" as access
  participant "AccountsController" as ctrl
end box
box "Backend - MissionControl.Application and Domain" #ECFDF3
  participant "ValidationBehavior" as validation
  participant "ListAccountsQueryHandler /\nGetAccountQueryHandler" as handler
  participant "UserAccount" as entity
end box
box "Backend - MissionControl.Infrastructure" #FFF4E5
  participant "IAuditEventWriter" as audit
  database "Mission Control SQL" as db
end box
actor -> page : Open /accounts or /accounts/:id, or the page increments its refresh counter after a dialog outcome
page -> page : Show loading skeleton
page -> client : AccountView: accountsResource(ListAccountsQuery); AccountDetailView: accountResource(GetAccountQuery { id }); a refresh change calls reload() on the view's resource
client -> access : GET /api/accounts or GET /api/accounts/{id}
access -> access : L2-002 validate signature, issuer, audience, subject, expiry (zero clock skew)
access -> db : LoadAccountAccessAsync: current status, role and credential version
db --> access : Current account access
alt Missing, invalid or expired JWT; inactive or missing account; credential version changed
  access -> audit : AppendRestrictedAsync(Denied); no payload
  access --> client : 401
  client --> page : sessionInterceptor: end(Unauthorized) once for this generation; the read rejects with its 401; login opens (session-ended) with this route to return to
else Authenticated Collaborator (profile P: no accounts.manage)
  access -> audit : AppendRestrictedAsync(Denied); no payload
  access --> client : 403
  client --> page : refreshCapabilities() (deduplicated); AccountView or AccountDetailView emits forbidden; its page calls inject(ApplicationShell).showStatus(AccessDenied); no account data shown
else Administrator
  access -> ctrl : Authorized request
  ctrl -> validation : Send ListAccountsQuery or GetAccountQuery through MediatR 12.5.0
  validation -> validation : ListAccountsQuery: L2-045 page at least 1; pageSize 1-100 (default 25). A malformed {id:guid} matches no route (404)
  alt Invalid page or page size (directory only)
    validation --> ctrl : 400 field errors; nothing read
    ctrl --> client : Validation ProblemDetails
    client --> page : AccountView shows the API page-size message in place of the list; no Try again or reference ID, since repeating the request would be refused again (the view itself only requests valid pages)
  else Valid request
    validation -> handler : Handle the query
    handler -> db : ListAccountsAsync(page, pageSize, designatedEmail): bounded page ordered by last name, first name, then ID with a window total; or LoadAccountDetailAsync(id, designatedEmail); designatedEmail comes from InitializationOptions
    db --> handler : Rows and total, or one account, or no row
    alt GetAccountQuery: account ID not found
      handler --> ctrl : 404; nothing read
      ctrl --> client : NotFound ProblemDetails
      client --> page : AccountDetailView not-found state with a link back to Accounts
    else Records found
      handler -> entity : Project safe summaries; exclude password hash and credential material
      entity --> handler : Names, email, role, active, inactive-since date, version, and designated (normalized email equals designatedEmail); detail adds the creation date and creator name
      handler --> ctrl : 200 AccountSummaryPage with the full matching count, or 200 AccountDetail
      ctrl --> client : Success response
      client --> page : Update signals; designated account shows protected status
      page --> actor : Accounts list or details; focus the page heading
    end
  end
end
note over ctrl, db
Unexpected failures return generic 500 plus correlation ID (L2-043);
the list or detail view shows its error state with Try again and that reference ID.
A read that gets no response shows the same error state without a reference ID.
Diagnostics exclude secrets and contact payloads.
end note
@enduml
