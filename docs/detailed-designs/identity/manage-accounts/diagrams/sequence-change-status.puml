@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
title Behavior - Deactivate or reactivate account
actor "Administrator" as actor
box "Frontend - Mission Control application" #E0F2FE
  participant "AccountStatusDialog / AccountView" as page
  participant "IAccountService / AccountService" as client
end box
box "Backend - MissionControl.Api" #D1FADF
  participant "CurrentAccountAuthorization" as access
  participant "AccountsController" as ctrl
end box
box "Backend - MissionControl.Application and Domain" #ECFDF3
  participant "ValidationBehavior" as validation
  participant "ChangeAccountStatusCommandHandler" as handler
  participant "DesignatedAdministratorPolicy / UserAccount" as entity
end box
box "Backend - MissionControl.Infrastructure" #FFF4E5
  participant "IAuditEventWriter" as audit
  database "Mission Control SQL" as db
end box
actor -> page : Confirm Deactivate or Reactivate (dialog names the account)
page -> page : Disable both buttons; show progress
page -> client : Build typed ChangeAccountStatusCommand (id, active, expectedVersion)
client -> access : PUT /api/accounts/{id}/status
access -> access : L2-002 validate signature, issuer, audience, subject, expiry (zero clock skew)
access -> db : Read current status, role and credential version
db --> access : Current account access
alt Missing, invalid or expired JWT; inactive or missing account; credential version changed
  access -> audit : Append Denied audit (restricted append; no payload)
  access --> client : 401
  client --> page : Clear in-memory session; open login (session-ended); nothing changed
else Authenticated Collaborator (profile P: no account management)
  access -> audit : Append Denied audit (restricted append; no payload)
  access --> client : 403
  client --> page : Show access-denied page; nothing changed
else Administrator
  access -> ctrl : Authorized request
  ctrl -> validation : Send ChangeAccountStatusCommand through MediatR 12.5.0
  validation -> validation : Validate identifier, active flag and expectedVersion
  alt Invalid request
    validation --> ctrl : 400 field errors; no business mutation
    ctrl --> client : Validation ProblemDetails
    client --> page : Keep dialog open; show failed state with the message; nothing changed
  else Valid request
    validation -> handler : Handle ChangeAccountStatusCommand
    handler -> db : Load account by ID
    db --> handler : Current account or none
    alt Account missing
      handler --> ctrl : 404; nothing changed
      ctrl --> client : NotFound ProblemDetails
      client --> page : Close dialog; account detail shows not-found state with link back to Accounts
    else Account found
      handler -> entity : L2-008 reject deactivation of the designated administrator -> 409
      entity --> handler : Allowed or protected
      alt Designated account and active = false
        handler -> audit : Append Rejected audit via restricted append, outside any business transaction (L2-039.2)
        audit -> db : Insert audit event only
        handler --> ctrl : 409 protected-identity with explanation; account stays active
        ctrl --> client : Conflict ProblemDetails (protected-identity)
        client --> page : blocked state: explain the designated administrator must stay active; Close only, no retry
      else Stored version differs from expectedVersion
        handler --> ctrl : 409 stale version; nothing changed
        ctrl --> client : Conflict ProblemDetails (stale)
        client -> access : GET /api/accounts/{id} once (authorized as above)
        access --> client : Latest account summary and version
        client --> page : stale state: nothing changed; Review account opens the latest details; no resubmission
      else Permitted change at current version
        handler -> entity : L2-004 set active flag; password, role and assignments kept
        entity --> handler : Updated account
        handler -> db : L2-039 / L2-040 update where version matches; success audit in the same transaction
        alt Racing save changed the version
          db --> handler : 0 rows; roll back update and audit
          handler --> ctrl : 409 stale version, handled as above
          ctrl --> client : Conflict ProblemDetails (stale)
          client --> page : Same handling as the stale branch above
        else Commit fails unexpectedly
          db --> handler : Roll back business state and success audit
          handler --> ctrl : Generic 500 with correlation ID
          ctrl --> client : Failure; no successful-save claim
          client --> page : failed state: nothing changed; reference ID; Try again repeats the request
        else Commit succeeds
          db --> handler : New committed version
          handler --> ctrl : 200 with safe account summary and version
          ctrl --> client : Success response
          client --> page : Close dialog; refresh account; toast names the account and result
          page --> actor : Deactivated account's tokens return 401 on their next request (L2-002.3)
        end
      end
    end
  end
end
note over ctrl, db
Unexpected failures return generic 500 plus correlation ID (L2-043).
Diagnostics exclude secrets and contact payloads.
end note
@enduml
