@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
title Behavior - Provision account
actor "Administrator" as actor
box "Frontend - Mission Control application" #E0F2FE
  participant "AccountFormDialog / AccountView" as page
  participant "IAccountService / AccountService" as client
end box
box "Backend - MissionControl.Api" #D1FADF
  participant "CurrentAccountAuthorization" as access
  participant "AccountsController" as ctrl
end box
box "Backend - MissionControl.Application and Domain" #ECFDF3
  participant "ValidationBehavior" as validation
  participant "ProvisionAccountCommandHandler" as handler
  participant "UserAccount" as entity
end box
box "Backend - MissionControl.Infrastructure" #FFF4E5
  participant "IAuditEventWriter" as audit
  database "Mission Control SQL" as db
end box
actor -> page : Enter names, email, initial password and role; Add account
page -> page : Disable repeat submission; show saving progress
page -> client : Build typed ProvisionAccountCommand
client -> access : POST /api/accounts
access -> access : L2-002 validate signature, issuer, audience, subject, expiry (zero clock skew)
access -> db : Read current status, role and credential version
db --> access : Current account access
alt Missing, invalid or expired JWT; inactive or missing account; credential version changed
  access -> audit : Append Denied audit (restricted append; no payload)
  access --> client : 401
  client --> page : Clear in-memory session; open login (session-unsaved); no account was added
else Authenticated Collaborator (profile P: no account management)
  access -> audit : Append Denied audit (restricted append; no payload)
  access --> client : 403
  client --> page : Show access-denied page; no account was added
else Administrator
  access -> ctrl : Authorized request
  ctrl -> validation : Send ProvisionAccountCommand through MediatR 12.5.0
  validation -> validation : L2-004 trim names (1-100); email syntax (at most 254); known role; password 12-128, untrimmed
  alt Invalid request
    validation --> ctrl : 400 field errors; no business mutation
    ctrl --> client : Validation ProblemDetails
    client --> page : validation state: keep valid input; focus linked error summary
  else Valid request
    validation -> handler : Handle ProvisionAccountCommand
    handler -> db : Find account with the normalized email
    db --> handler : Existing account or none
    alt Normalized email already used
      handler --> ctrl : 409 duplicate with the existing account ID and name; nothing created
      ctrl --> client : Conflict ProblemDetails (duplicate)
      client --> page : duplicate state: keep every value including the password; flag email; link the existing account
    else Email available
      handler -> entity : L2-004 / L2-036 create active account; salted hash of the exact password
      entity --> handler : New account (version 1, credential version 1)
      handler -> db : L2-039 / L2-040 insert account and success audit in one transaction
      alt Unique index rejects the email (racing provision)
        db --> handler : Roll back insert and audit
        handler --> ctrl : 409 duplicate, as above
        ctrl --> client : Conflict ProblemDetails (duplicate)
        client --> page : Same handling as the duplicate branch above
      else Commit fails unexpectedly
        db --> handler : Roll back business state and success audit
        handler --> ctrl : Generic 500 with correlation ID
        ctrl --> client : Failure; no successful-save claim
        client --> page : failed state: keep every value; reference ID; Add account retries
      else Commit succeeds
        db --> handler : Committed account
        handler --> ctrl : 201 with safe summary; never the password or hash
        ctrl --> client : Success response
        client --> page : created state: share the password directly; it is not shown again
        page --> actor : New row appears in Accounts; no lead contact created (L2-005.2)
      end
    end
  end
end
note over ctrl, db
Unexpected failures return generic 500 plus correlation ID (L2-043).
Diagnostics exclude secrets and contact payloads.
end note
@enduml
