@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
title Behavior - End a session on logout, reload, or expiry
actor "Account holder" as actor
box "Frontend - Mission Control application" #E0F2FE
  participant "Application page / dialog" as page
  participant "Session / form signals" as state
  participant "Router / focus management" as router
end box
box "Backend - MissionControl.Api" #D1FADF
  participant "Protected API" as api
end box
actor -> page : Select logout / reload / expiry occurs
alt Explicit logout with dirty draft
  page -> state : Open UnsavedChangesDialog (sign-out) (L2-031.4)
  state --> page : Stay or Sign out without saving
  opt Stay selected
    page --> actor : Retain session and draft; no request sent
  end
end
opt Logout confirmed / reload / token expiry / API 401
  page -> state : L2-003 ISessionService.logout(): clear memory token and protected caches
  state -> state : Cancel requests; increment session generation
  state --> page : Session ended; late responses ignored
  page -> router : Navigate to login without protected data
  router --> actor : Login shows signed-out after logout; session-ended after expiry, reload or 401; session-unsaved if a draft was lost
end
note over state, api
Local logout does not revoke a copied valid token.
Protected requests still validate expiry (zero clock skew) and current SQL access.
end note
@enduml
