@startuml
!include <C4/C4_Container>
LAYOUT_WITH_LEGEND()
title Containers - Sign in and end a session
Person(actor, "Account holder", "Sign in and end a session")
System_Boundary(mc, "Mission Control") {
  Container(web, "Mission Control web client", "Angular", "Sign in and end a session")
  Container(api, "MissionControl.Api", ".NET", "Authorized application handlers")
  ContainerDb(db, "Mission Control database", "SQL - provider <TO SUPPLY>", "UserAccount and related records")
}
Rel(actor, web, "Uses")
Rel(web, api, "Requests feature behavior", "HTTPS / JSON")
Rel(api, db, "Reads or commits feature records", "Parameterized SQL")
@enduml
