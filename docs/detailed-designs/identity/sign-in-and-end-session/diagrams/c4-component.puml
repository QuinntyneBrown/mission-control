@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components - Sign in and end a session
Container_Boundary(web, "Mission Control web client (Angular)") {
  Component(login, "LoginPage / SessionView", "mission-control / domain", "Sign-in form and login notice; after sign-in refreshes capabilities, then opens the permitted requested path or Home")
  Component(session, "SessionService", "api / ISessionService", "In-memory token, generation, capability summary, expiry timer; end(reason)")
  Component(icpt, "sessionInterceptor", "api / HTTP interceptor", "Bearer token, generation capture, abort on end, stale discard, 401 and 403 routing")
}
ContainerDb(db, "Mission Control database", "SQL", "Accounts, login attempts and audit events")
Container_Boundary(api, "MissionControl.Api runtime") {
  Component(access, "CurrentAccountAuthorization", "API authentication / authorization", "Validates JWT with zero clock skew and checks current SQL account access")
  Component(ctrl, "SessionsController", "API boundary", "Binds request and dispatches through MediatR 12.5.0")
  Component(validation, "ValidationBehavior", "Application pipeline", "Invokes request validators")
  Component(h0, "LoginCommandHandler", "Application / MediatR", "Authenticate credentials; record failures and throttle")
  Component(h1, "GetCurrentSessionQueryHandler", "Application / MediatR", "Read the capability summary")
  Component(ports, "IPasswordHashService / IAccessTokenIssuer", "Application ports", "Verify a password; issue an access token")
  Component(adapters, "PasswordHashService / JwtAccessTokenIssuer", "Infrastructure", "Salted hash; signing with JwtOptions")
  Component(store, "MissionControlDataSession", "Infrastructure", "Implements IMissionControlDataSession: typed reads, AddAuditEvent and SaveChangesAsync")
  Component(audit, "AuditEventWriter", "Infrastructure / IAuditEventWriter", "AppendRestrictedAsync: Denied and Throttled outside any business transaction")
}
Rel(login, session, "login(); refreshCapabilities(); reads signedIn, endReason and currentSession", "inject SESSION_SERVICE")
Rel(session, icpt, "Its requests and every protected adapter request pass through")
Rel(icpt, access, "All /api requests; POST /api/sessions carries no token", "HTTPS")
Rel(access, store, "LoadAccountAccessAsync: current status, role and credential version")
Rel(access, audit, "Appends Denied")
Rel(access, ctrl, "Forwards authenticated GET /api/session; POST /api/sessions is public")
Rel(ctrl, validation, "Sends typed request")
Rel(validation, h0, "Dispatches validated LoginCommand")
Rel(validation, h1, "Dispatches GetCurrentSessionQuery")
Rel(h0, ports, "Verifies and issues through")
Rel_R(adapters, ports, "Implement")
Rel(h0, store, "Loads account and attempt; AddAuditEvent for a successful login; saves")
Rel(h0, audit, "Appends Denied and Throttled")
Rel(h1, store, "Reads current authority")
Rel(store, db, "Parameterized queries / atomic writes", "SQL")
Rel(audit, db, "Inserts audit events", "SQL")
@enduml
