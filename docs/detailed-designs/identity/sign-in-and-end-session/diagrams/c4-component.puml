@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components - Sign in and end a session
Container(web, "Mission Control web client", "Angular", "LoginPage / SessionView; SessionService holds the token in memory")
ContainerDb(db, "Mission Control database", "SQL", "Versioned feature records and audit events")
Container_Boundary(api, "MissionControl.Api runtime") {
  Component(ctrl, "SessionsController", "API boundary", "Binds request and dispatches through MediatR 12.5.0")
  Component(access, "CurrentAccountAuthorization", "API authentication / authorization", "Validates JWT with zero clock skew and checks current SQL account access")
  Component(validation, "ValidationBehavior", "Application pipeline", "Invokes request validators")
  Component(entity, "UserAccount / LoginAttempt", "Domain / read model", "Credentials, status, credential version, throttle window")
  Component(projection, "CurrentSession", "Application / read projection", "Account ID, display name, role, capability summary; no contact data")
  Component(store, "MissionControlDataSession", "Infrastructure", "Implements Application data port; commits transactions")
Rel(web, access, "Calls through ISessionService / SessionService", "HTTPS")
Rel(access, db, "Checks current access for protected requests", "SQL")
Rel(access, ctrl, "Forwards authorized request; login remains public")
Rel(ctrl, validation, "Sends typed request")
Component(h0, "LoginCommandHandler", "Application / MediatR", "Authenticate credentials")
Rel(validation, h0, "Dispatches validated request")
Rel(h0, entity, "Verifies password; records failures and throttle")
Rel(h0, store, "Loads / persists state")
Component(h1, "GetCurrentSessionQueryHandler", "Application / MediatR", "Check current access")
Rel(validation, h1, "Dispatches request")
Rel(h1, projection, "Projects")
Rel(h1, store, "Loads current authority")
}
Rel(store, db, "Executes bounded queries / atomic writes", "SQL")
@enduml
