@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components - Review security and mutation audit events
Container(web, "Mission Control web client", "Angular", "AuditLogPage / AuditEventView")
ContainerDb(db, "Mission Control database", "SQL", "Versioned feature records and audit events")
Container_Boundary(api, "MissionControl.Api runtime") {
  Component(ctrl, "AuditEventsController", "API boundary", "Binds request and dispatches through MediatR 12.5.0")
  Component(access, "CurrentAccountAuthorization", "API authentication / authorization", "Validates JWT and checks current SQL account access")
  Component(validation, "ValidationBehavior", "Application pipeline", "Invokes request validators")
  Component(entity, "AuditEvent / AuditOutcome / AuditArea", "Domain / read model", "Outcome Succeeded, Rejected, Denied, or Throttled; one of seven stored areas")
  Component(store, "MissionControlDataSession", "Infrastructure", "Implements IMissionControlDataSession: bounded audit and actor reads; AddAuditEvent for success audits")
  Component(writer, "AuditEventWriter", "Infrastructure", "AppendRestrictedAsync: Rejected, Denied and Throttled outside any business transaction")
Rel(web, access, "Calls through IAuditEventService / AuditEventService; session protocol via sessionInterceptor", "HTTPS")
Rel(access, store, "LoadAccountAccessAsync for protected requests")
Rel(access, writer, "Appends Denied outcomes")
Rel(access, ctrl, "Forwards administrator requests")
Rel(ctrl, validation, "Sends typed request")
Component(h0, "ListAuditEventsQueryHandler / ListAuditActorsQueryHandler", "Application / MediatR", "Read and filter immutable audit events; search actor choices")
Rel(validation, h0, "Dispatches validated request")
Rel(h0, entity, "Projects safe rows")
Rel(h0, store, "Reads bounded pages")
}
Rel(store, db, "Executes bounded queries; commits success audits with their change", "SQL")
Rel(writer, db, "Inserts audit events; never updates or deletes", "SQL")
@enduml
