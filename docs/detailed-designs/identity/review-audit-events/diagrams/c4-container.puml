@startuml
!include <C4/C4_Container>
LAYOUT_WITH_LEGEND()
title Containers - Review security and mutation audit events
Person(actor, "Administrator", "Review security and mutation audit events")
System_Boundary(mc, "Mission Control") {
  Container(web, "Mission Control web client", "Angular", "Review security and mutation audit events")
  Container(api, "MissionControl.Api", ".NET", "Authorized application handlers")
  ContainerDb(db, "Mission Control database", "SQL - provider <TO SUPPLY>", "AuditEvent and related records")
}
Rel(actor, web, "Uses")
Rel(web, api, "Requests feature behavior", "HTTPS / JSON")
Rel(api, db, "Reads or commits feature records", "Parameterized SQL")
@enduml
