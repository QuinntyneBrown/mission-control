@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
title Behavior - Read and filter immutable audit events
actor "Administrator" as actor
box "Frontend - Mission Control application" #E0F2FE
  participant "AuditLogPage / AuditEventView" as page
  participant "IAuditEventService / AuditEventService" as client
end box
box "Backend - MissionControl.Api" #D1FADF
  participant "CurrentAccountAuthorization" as access
  participant "AuditEventsController" as ctrl
end box
box "Backend - MissionControl.Application and Domain" #ECFDF3
  participant "ValidationBehavior" as validation
  participant "ListAuditEventsQueryHandler" as handler
  participant "AuditEvent" as entity
end box
box "Backend - MissionControl.Infrastructure" #FFF4E5
  participant "IAuditEventWriter" as audit
  database "Mission Control SQL" as db
end box
actor -> page : Open /audit or change a filter or page
page -> page : Reset to page 1 on filter change; show loading skeleton
page -> client : Build typed ListAuditEventsQuery (actor, area, outcome, Toronto dates, page)
client -> access : GET /api/audit-events
access -> access : L2-002 validate signature, issuer, audience, subject, expiry (zero clock skew)
access -> db : Read current status, role and credential version
db --> access : Current account access
alt Missing, invalid or expired JWT; inactive or missing account; credential version changed
  access -> audit : Append Denied audit (restricted append; no payload)
  access --> client : 401
  client --> page : Clear in-memory session; open login (session-ended) with /audit to return to
else Authenticated Collaborator (L2-039: administrators only)
  access -> audit : Append Denied audit (restricted append; no payload)
  access --> client : 403
  client --> page : Show access-denied page; no audit data shown
else Administrator
  access -> ctrl : Authorized request
  ctrl -> validation : Send ListAuditEventsQuery through MediatR 12.5.0
  validation -> validation : L2-045 page size 1-100; known outcome and area; from not after to
  alt Invalid filter, date range or page size
    validation --> ctrl : 400 field errors; nothing read
    ctrl --> client : Validation ProblemDetails
    client --> page : Keep the filters; show the field message beside the invalid filter
  else Valid request
    validation -> handler : Handle ListAuditEventsQuery
    handler -> handler : Convert Toronto dates to half-open UTC interval
    handler -> db : L2-039 bounded read of immutable event metadata; AND filters; newest first, then ID
    db --> handler : Page of events and full matching count
    handler -> entity : Project timestamp, actor ID, operation, entity type and ID, outcome, correlation ID
    entity --> handler : Safe audit rows; no secret or contact payload
    handler --> ctrl : 200 with rows and total count
    ctrl --> client : Success response
    alt No matching events
      client --> page : filtered-zero state: announce 0 events; offer Clear filters
    else Events found
      client --> page : Update signals; announce the matching count
      page --> actor : Toronto time with UTC beneath; Unknown for events without an actor
    end
  end
end
note over ctrl, db
Unexpected failures return generic 500 plus correlation ID (L2-043);
the page shows its error state with the reference ID and Try again.
Viewing never changes the audit log; no edit or delete endpoint exists.
end note
@enduml
