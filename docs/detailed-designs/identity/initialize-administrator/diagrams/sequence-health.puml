@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
title Behavior - Observe liveness and readiness
actor "Deployment operator or orchestrator" as actor
box "Backend - MissionControl.Api host" #D1FADF
  participant "HealthController" as ctrl
end box
box "Backend - MissionControl.Application and Domain" #ECFDF3
  participant "GetReadinessQueryHandler" as handler
  participant "InitializationStatus" as status
end box
box "Backend - MissionControl.Infrastructure" #FFF4E5
  participant "IDatabaseReadinessProbe" as probe
  database "Mission Control SQL" as db
end box
alt GET /health/live
  actor -> ctrl : Liveness probe
  ctrl --> actor : L2-042.4 200 while the process runs; no SQL dependency
else GET /health/ready
  actor -> ctrl : Readiness probe
  ctrl -> handler : Send GetReadinessQuery through MediatR 12.5.0 (request cancellation token)
  handler -> status : Read InitializationState
  status --> handler : Initializing, Ready or Failed
  alt Initializing or Failed
    handler --> ctrl : Not ready
    ctrl --> actor : 503; no secret, connection string or exception detail
  else Ready
    handler -> probe : CheckAsync(ct)
    probe -> db : Check SQL access and compatible schema version
    alt SQL unavailable or schema incompatible
      db --> probe : Failure
      probe --> handler : false; diagnostic with correlation ID
      handler --> ctrl : Not ready
      ctrl --> actor : 503; no secret, connection string or exception detail
    else Available and compatible
      db --> probe : OK
      probe --> handler : true
      handler --> ctrl : Ready
      ctrl --> actor : 200 ready
    end
  end
end
@enduml
