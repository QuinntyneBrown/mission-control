@startuml
!include <C4/C4_Container>
LAYOUT_WITH_LEGEND()
title Containers - Initialize and protect the administrator
Person(actor, "Deployment operator", "Runs documented release procedure")
System_Boundary(mc, "Mission Control operations") {
  Container(runner, "Initialization runtime", ".NET / Microsoft.Extensions", "Migrations, required seeds, and readiness")
  Container(api, "MissionControl.Api", ".NET", "Health status and behavioral verification")
  ContainerDb(db, "Mission Control SQL", "SQL - provider <TO SUPPLY>", "Durable accounts, work, and sprint snapshots")
}
Rel(actor, runner, "Starts / configures")
Rel(runner, db, "Initializes / verifies", "SQL")
Rel(actor, api, "Observes health or verifies behavior", "HTTPS")
Rel(api, db, "Checks or reads restored data", "Parameterized SQL")
@enduml
