@startuml
!include <C4/C4_Container>
LAYOUT_WITH_LEGEND()
title Containers - Initialize and protect the administrator
Person(actor, "Deployment operator", "Supplies configuration, starts instances, probes health")
System_Boundary(mc, "Mission Control") {
  Container(api, "MissionControl.Api", ".NET / Microsoft.Extensions hosting", "DatabaseInitializer hosted service runs migrations and required seeds at startup; health endpoints")
  ContainerDb(db, "Mission Control SQL", "SQL - provider <TO SUPPLY>", "Schema, accounts, contacts, seed marker, initialization lock")
}
System_Ext(config, "External configuration", "Secret facility <TO SUPPLY>: bootstrap identity, initial password, signing material")
Rel(actor, config, "Supplies values")
Rel(actor, api, "Starts instances; GET /health/live and /health/ready", "HTTPS")
Rel(api, config, "Binds InitializationOptions and JwtOptions at startup")
Rel(api, db, "Locks, migrates, seeds, and checks readiness", "Parameterized SQL")
@enduml
