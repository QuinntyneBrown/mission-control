@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
title Class structure - Initialize and protect the administrator
interface IHostedService <<Microsoft.Extensions.Hosting>> {
  +startAsync(token: CancellationToken): Task
  +stopAsync(token: CancellationToken): Task
}
class DatabaseInitializer <<Infrastructure>> {
  +startAsync(token: CancellationToken): Task
}
class InitializationOptions <<Options>> {
  +designatedEmail: string
  +firstName: string
  +lastName: string
  +initialPassword: string?
}
interface IInitializationLock {
  +acquire(token: CancellationToken): Task<IAsyncDisposable>
}
interface IMigrationRunner {
  +migrate(): Task<void>
}
class EnsureAdministratorCommand {
  +email: string
  +firstName: string
  +lastName: string
  +initialPassword: string?
}
class EnsureAdministratorCommandHandler {
  +handle(request: EnsureAdministratorCommand): Task<UserAccount>
}
class EnsureCityLeadCommand {
  +email: string
  +firstName: string
  +lastName: string
}
class EnsureCityLeadCommandHandler {
  +handle(request: EnsureCityLeadCommand): Task<LeadContact>
}
class InitializationState {
  +phase: InitializationPhase
  +schemaCompatible: bool
  +administratorReady: bool
  +correlationId: string?
  +ready(): bool
}
enum InitializationPhase {
  Initializing
  Ready
  Failed
}
class InitializationStatus <<Application singleton>> {
  +current: InitializationState
  +record(state: InitializationState): void
}
class HealthController <<MissionControl.Api.Controllers>> {
  -sender: ISender
  +live(): IActionResult
  +ready(): Task<IActionResult>
}
class GetReadinessQuery
class GetReadinessQueryHandler {
  +handle(request: GetReadinessQuery): Task<ReadinessResult>
}
class UserAccount {
  +id: Guid
  +firstName: string
  +lastName: string
  +passwordHash: string
  +credentialVersion: long
  +active: bool
  +role: AccountRole
}
class LeadContact {
  +id: Guid
  +email: string
  +category: LeadCategory
  +phone: string?
}
IHostedService <|.. DatabaseInitializer
DatabaseInitializer ..> InitializationOptions : binds
DatabaseInitializer ..> IInitializationLock : holds for the run
DatabaseInitializer ..> IMigrationRunner : migration
DatabaseInitializer ..> EnsureAdministratorCommand : sends
DatabaseInitializer ..> EnsureCityLeadCommand : sends
DatabaseInitializer --> InitializationStatus : records outcome
EnsureAdministratorCommandHandler ..> EnsureAdministratorCommand : handles
EnsureCityLeadCommandHandler ..> EnsureCityLeadCommand : handles
EnsureAdministratorCommandHandler --> UserAccount : creates / repairs
EnsureCityLeadCommandHandler --> LeadContact : creates / adopts once
InitializationStatus --> InitializationState
InitializationState --> InitializationPhase
HealthController ..> GetReadinessQuery : dispatches
GetReadinessQueryHandler ..> GetReadinessQuery : handles
GetReadinessQueryHandler ..> InitializationStatus : reads
@enduml
