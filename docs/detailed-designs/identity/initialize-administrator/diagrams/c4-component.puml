@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components - Initialize and protect the administrator
Container_Boundary(runtime, "MissionControl.Api host") {
  Component(init, "DatabaseInitializer", "Infrastructure / BackgroundService", "ExecuteAsync runs after the host starts listening; checks JwtOptions signing material first, then migrations and one seed command; records InitializationState")
  Component(lock, "IInitializationLock / SQL adapter", "Infrastructure", "Database-wide lock held for the whole run (L2-007.2)")
  Component(migrations, "IMigrationRunner / SQL adapter", "Infrastructure", "Applies only missing versioned migrations")
  Component(seeds, "EnsureRequiredSeedsCommandHandler", "Application / MediatR 12.5.0", "Creates or repairs the protected account, seeds the City contact once, sets the marker, registers an audit event per change; one SaveChangesAsync")
  Component(store, "MissionControlDataSession", "Infrastructure", "Implements IMissionControlDataSession: typed loads, AddAccount, AddLead, AddSeedMarker, AddAuditEvent, SaveChangesAsync")
  Component(status, "InitializationStatus", "Application", "Holds the latest InitializationState")
  Component(health, "HealthController / GetReadinessQueryHandler", "API and Application", "Liveness answers directly; readiness reads status, then the probe")
  Component(probe, "IDatabaseReadinessProbe / SQL adapter", "Infrastructure", "CheckAsync: SQL access and compatible schema")
}
ContainerDb(db, "Mission Control SQL", "SQL", "Schema, accounts, contacts, seed marker, audit events")
Rel(init, lock, "Acquires before migrating; releases after the seeds commit or fail")
Rel(init, migrations, "Migrates under lock")
Rel(init, seeds, "Sends EnsureRequiredSeedsCommand")
Rel(init, status, "Records Initializing, Ready or Failed")
Rel(seeds, store, "Loads account, City contact and marker; adds what is missing; commits once")
Rel(lock, db, "Takes the database-wide lock")
Rel(migrations, db, "Applies versioned schema")
Rel(store, db, "One seed transaction", "SQL")
Rel(health, status, "Reads initialization result")
Rel(health, probe, "Checks when Ready")
Rel(probe, db, "Checks access and compatible schema")
@enduml
