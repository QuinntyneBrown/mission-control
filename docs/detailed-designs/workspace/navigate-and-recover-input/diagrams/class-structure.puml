@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
title Class structure - Navigate with context and preserve form input
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
package "frontend/projects/mission-control" {
  class ApplicationShell {
    +routeContext: Signal<RouteContext>
    +menuOpen: Signal<bool>
    +focusHeading(): void
  }
  class RouteContext {
    +requestedPath: string
    +workspaceId: Guid?
    +ancestorIds: Guid[]
  }
  class AuthenticationGuard {
    +canActivate(path: string): Promise<bool | UrlTree>
  }
  class PermissionGuard {
    +canActivate(path: string): Promise<bool | UrlTree>
  }
  class UnsavedChangesGuard {
    +canDeactivate(form: FormDraft): Promise<bool>
  }
  interface FormDraft {
    +dirty: Signal<bool>
    +pending: Signal<bool>
    +canLeave(): bool
  }
  class UnsavedChangesDialog {
    +confirm(itemName: string): Promise<LeaveChoice>
  }
  enum LeaveChoice {
    Stay
    Discard
  }
}
package "frontend/projects/domain" {
  class UserMenuView {
    +account: Signal<CurrentSession>
    +signOut: Output<void>
  }
}
package "frontend/projects/api" {
  interface ISessionService {
    +check_access(request: GetCurrentSessionQuery): Promise<FeatureResult>
  }
  class SessionService {
    -http: HttpClient
    -sessionGeneration: long
  }
}
package "backend" {
  class SessionsController {
    -sender: ISender
  }
  class GetCurrentSessionQuery {
    +subject: Guid
  }
  class GetCurrentSessionQueryHandler {
    +handle(request: GetCurrentSessionQuery): Task<FeatureResult>
  }
  class CurrentSession {
    +accountId: Guid
    +displayName: string
    +role: AccountRole
    +capabilities: string[]
  }
  interface IMissionControlDataSession {
    +query(specification): Task<ReadResult>
    +commit(expectedVersion: long): Task<void>
  }
  class MissionControlDataSession {
    -connection: DbConnection
  }
}
ApplicationShell --> RouteContext : holds signal
ApplicationShell --> UserMenuView : composes
AuthenticationGuard --> RouteContext : stores requestedPath
AuthenticationGuard ..> ISessionService : inject SESSION_SERVICE
PermissionGuard ..> ISessionService : inject SESSION_SERVICE
UserMenuView ..> ISessionService : inject SESSION_SERVICE
UnsavedChangesGuard ..> FormDraft : checks canLeave()
UnsavedChangesGuard ..> UnsavedChangesDialog : opens when dirty
UnsavedChangesDialog --> LeaveChoice
ISessionService <|.. SessionService
IMissionControlDataSession <|.. MissionControlDataSession
SessionsController ..> GetCurrentSessionQuery : dispatches
GetCurrentSessionQueryHandler ..> GetCurrentSessionQuery : handles
GetCurrentSessionQueryHandler --> CurrentSession : projects
GetCurrentSessionQueryHandler ..> IMissionControlDataSession : uses
@enduml
