@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
title Behavior - Confirm navigation away from unsaved input
actor "Account holder" as actor
box "Frontend - Mission Control application" #E0F2FE
  participant "Form page or dialog\n(FormDraft)" as page
  participant "UnsavedChangesGuard" as guard
  participant "UnsavedChangesDialog" as dialog
  participant "Router / focus management" as router
  participant "ISessionService /\nSessionService" as session
end box
box "Backend - MissionControl.Api" #D1FADF
  participant "Protected API" as api
end box

== Leave, cancel, or sign out with a draft (L2-031.4) ==
actor -> page : Choose another destination, Cancel / Close / Escape, or Sign out
page -> guard : canDeactivate(FormDraft)
guard -> page : Read pending and dirty (draft compared with saved baseline)
alt Clean draft
  page --> guard : canLeave() = true
  guard -> router : Proceed: open destination, close dialog, or sign out
  router --> actor : Focus destination heading or the dialog's trigger (L2-033.2, L2-033.4)
else Save pending
  page --> guard : pending = true
  note right of page
    Save shows progress and ignores repeat clicks;
    Cancel and Close are disabled while it is pending (L2-031.2).
  end note
  guard -> guard : Hold the route change until the save resolves
  alt Save succeeds
    page --> guard : Baseline updated; draft clean
    guard -> router : Proceed to the destination
    router --> actor : Saved result announced; focus destination heading
  else Save rejected or fails
    page --> guard : Draft kept with field errors or the save error
    guard -> dialog : Open as for a dirty draft
  end
else Dirty draft, not pending
  page --> guard : dirty = true; canLeave() = false
  guard -> dialog : confirm(item name)
  dialog -> router : Trap focus; start on the safe choice (L2-033.2)
  router --> actor : Dialog names what would be lost
  alt Stay or Escape
    actor -> dialog : Stay on this page / Keep editing / Stay signed in
    dialog --> guard : Stay
    guard --> page : Cancel the route change
    page -> router : Restore focus to the trigger
    router --> actor : Draft intact, session kept
  else Discard
    actor -> dialog : Leave without saving / Discard changes / Sign out without saving
    dialog --> guard : Discard
    guard -> page : Drop draft; no save request
    page --> guard : Saved record unchanged
    guard -> router : Navigate, close the form, or sign out
    router --> actor : Focus destination heading or surviving trigger; sign-out opens sign-in with "You've signed out"
  end
end

== Session ends while the draft is dirty (L2-003.4) ==
page -> api : Any protected request after token expiry or deactivation
api --> session : 401
session -> session : Clear token and protected caches; ignore late responses from the earlier session generation
session --> page : Unauthenticated
page -> router : Store requestedPath; no unsaved-changes dialog (nothing can be saved without a session)
router --> actor : Sign-in shows "Your session ended before your changes were saved"; nothing reported as saved

note over page, api
Cancellation and discarded input send no mutation request.
Reload or tab close uses the browser's own unload prompt instead of UnsavedChangesDialog.
end note
@enduml
