@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
title Behavior - Check session and restore a permitted route
actor "Account holder" as actor
box "Frontend - Mission Control application" #E0F2FE
  participant "ApplicationShell / Router" as shell
  participant "AuthenticationGuard /\nPermissionGuard" as guard
  participant "LoginPage" as login
  participant "ISessionService /\nSessionService" as session
  participant "Route's record service" as records
end box
box "Backend - MissionControl.Api" #D1FADF
  participant "CurrentAccountAuthorization" as access
  participant "SessionsController /\nGetCurrentSessionQueryHandler" as sessionApi
  participant "Route's record controller /\nquery handler" as recordApi
end box
box "Backend - MissionControl.Infrastructure" #FFF4E5
  database "Mission Control SQL" as db
end box

== 1. Direct protected URL with no session (L2-029.3, L2-003.3) ==
actor -> shell : Open a protected URL (reload, bookmark, or shared link)
shell -> guard : AuthenticationGuard.canActivate(path)
guard -> session : check_access(GetCurrentSessionQuery)
session --> guard : Unauthenticated: no token in memory, so no request is sent
guard -> guard : Accept internal application paths only; store RouteContext.requestedPath
guard -> login : Redirect to sign-in
login --> actor : "Sign in to continue" (deep-link); the record is not named and no protected data is requested

== 2. Sign in, refresh capabilities, apply permissions (L2-029.3, L2-002) ==
actor -> login : Submit email and password
login -> session : LoginCommand (sign-in-and-end-session slice)
session --> login : 200 token held in memory; new session generation
login -> session : check_access(GetCurrentSessionQuery)
session -> access : GET /api/session
access -> db : Read current status, role and credential version
db --> access : Active account
access -> sessionApi : Authenticated request; MediatR 12.5.0
sessionApi -> db : Read safe account summary
db --> sessionApi : Account ID, display name, role
sessionApi --> session : 200 CurrentSession: role and capability summary; no contact data
session --> login : Capabilities held in signals
login -> shell : Navigate to RouteContext.requestedPath
shell -> guard : PermissionGuard.canActivate(requestedPath)
alt Role lacks the route's capability (Accounts or Audit log for a Collaborator)
  guard --> shell : Deny before any record request
  shell --> actor : Access-denied page offering Home and Projects; focus heading (L2-029.4)
else Route permitted
  guard --> shell : Allow; clear requestedPath

  == 3. Route's existing record query (L2-029.2, L2-029.4) ==
  shell -> records : Load the route's record through its own service contract
  records -> access : GET the record endpoint, e.g. /api/workspaces/{id}/work-items/{itemId}
  access -> db : Read current status, role and credential version
  db --> access : Current account access
  alt 401: token expired, account deactivated, or credential version changed
    access --> records : 401 ProblemDetails; denial audited without payloads
    records -> session : Clear in-memory session and protected caches
    session --> shell : Unauthenticated
    shell --> actor : Store requestedPath; sign-in shows "Your session ended"
  else 403: role changed after capabilities were read (L2-002.4)
    access --> records : 403 ProblemDetails; denial audited without payloads
    records --> shell : Forbidden
    shell --> actor : Access-denied page offering permitted destinations; focus heading
  else Authorized
    access -> recordApi : Authenticated request
    recordApi -> db : Read record with its workspace and ancestor path
    alt 404: record missing or deleted
      db --> recordApi : No row
      recordApi --> records : 404 ProblemDetails
      records --> shell : Not found
      shell --> actor : Not-found page offering Home, Projects, and Leads; focus heading
    else 200: record found
      db --> recordApi : Record, workspace, ancestors
      recordApi --> records : 200 record projection
      records --> shell : Record and path
      shell -> shell : RouteContext = workspaceId and ancestorIds
      shell --> actor : Render page with ancestor links; focus heading (L2-033.4)
    end
  end
end
note over shell, db
GET /api/session reads only the token subject, so it has no 400 path.
A record request answered 500 shows the error page with its reference ID and Try again (L2-043);
one that cannot reach the API shows the offline page with Try again. Both keep the navigation.
end note
@enduml
