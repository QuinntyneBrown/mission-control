@startuml
!include <C4/C4_Container>
LAYOUT_WITH_LEGEND()
title Containers - Navigate with context and preserve form input
Person(actor, "Authorized user", "Navigate with context and preserve form input")
System_Boundary(mc, "Mission Control") {
  Container(web, "Mission Control web client", "Angular", "Navigate with context and preserve form input")
  Container(api, "MissionControl.Api", ".NET", "Authorized application handlers")
  ContainerDb(db, "Mission Control database", "SQL - provider <TO SUPPLY>", "Accounts, roles, and related records")
}
Rel(actor, web, "Uses")
Rel(web, api, "Requests feature behavior", "HTTPS / JSON")
Rel(api, db, "Reads current access and route records", "Parameterized SQL")
@enduml
