@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components - Review home coverage and progress
Container(web, "Mission Control web client", "Angular", "HomePage (New project, ProjectFormDialog) / LeadCoverageView, WorkspaceProgressView, ActiveSprintSummaryView, each with its own loading and error state")
ContainerDb(db, "Mission Control database", "SQL", "Leads, workspaces, work items, and sprints")
Container_Boundary(api, "MissionControl.Api runtime") {
  Component(ctrl, "HomeController", "API boundary", "Binds request and dispatches through MediatR 12.5.0")
  Component(access, "CurrentAccountAuthorization", "API authentication / authorization", "Validates JWT and checks current SQL account access")
  Component(validation, "ValidationBehavior", "Application pipeline", "Invokes request validators (page and pageSize)")
  Component(store, "MissionControlDataSession", "Infrastructure", "Implements IMissionControlDataSession typed reads; one snapshot per section response")
Rel(web, access, "Calls through IHomeService / HomeService; one request per section view; session protocol via sessionInterceptor", "HTTPS")
Rel(access, db, "Checks current access for protected requests", "SQL")
Rel(access, ctrl, "Forwards authenticated request")
Rel(ctrl, validation, "Sends typed request")
Component(h0, "GetLeadCoverageQueryHandler", "Application / MediatR", "Read all five lead category totals")
Component(p0, "LeadCoverage", "Application / read projection", "Five category counts and their total, zeros included")
Rel(validation, h0, "Dispatches request")
Rel(h0, p0, "Projects")
Rel(h0, store, "One grouped count statement")
Component(h1, "GetWorkspaceProgressQueryHandler", "Application / MediatR", "Read workspace progress summaries")
Component(p1, "WorkspaceProgressPage", "Application / read projection", "Workspace page, total count, type and status counts, work-item totals")
Rel(validation, h1, "Dispatches validated request")
Rel(h1, p1, "Projects")
Rel(h1, store, "Page, window total and grouped counts in one snapshot")
Component(h2, "GetActiveSprintSummaryQueryHandler", "Application / MediatR", "Read active sprint summaries")
Component(p2, "ActiveSprintSummaryPage", "Application / read projection", "Active Scrum sprints, total count, story counts and totals")
Rel(validation, h2, "Dispatches validated request")
Rel(h2, p2, "Projects")
Rel(h2, store, "Page, window total and story counts in one snapshot")
}
Rel(store, db, "Executes parameterized read queries", "SQL")
@enduml
