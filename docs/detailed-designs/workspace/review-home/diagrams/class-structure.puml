@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
title Class structure - Review home coverage and progress
left to right direction
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
class HomePage {
  +canCreateProject: Signal<bool>
  +draft: Signal<DraftState>
  -refresh: WritableSignal<number>
  +openNewProject(): void
}
note right of HomePage
  canCreateProject = computed from
  SESSION_SERVICE currentSession capabilities
  (workspaces.manage); shows the header New project,
  or the collaborator notice, and feeds
  WorkspaceProgressView. refresh feeds every
  section view's refresh input.
  openNewProject(): ProjectFormDialog without a
  workspace ID. Saved(SavedWorkspaceResult):
  "Project created" toast naming it, then
  /projects/:workspaceId; no result: nothing.
  The dialog's unconfirmed (still open):
  refresh + 1 at once, so WorkspaceProgressView
  rereads Projects before the project is
  saved again.
  FormDraft: draft delegates to the open dialog
  (clean when none); /home registers
  UnsavedChangesGuard. No section state is held:
  each view shows its own loading and error.
end note
class ProjectFormDialog {
  +workspaceId: InputSignal<Guid?>
  +draft: Signal<DraftState>
  +unconfirmed: OutputEmitterRef<void>
  +close(result: ProjectFormOutcome?): void
}
note right of ProjectFormDialog
  Application dialog owned by
  projects/manage-workspaces. Home opens it
  for a create and reacts to Saved and to
  unconfirmed. A 403 shows the dialog's own
  forbidden state; no forbidden output.
end note
class SavedWorkspaceResult {
  +id: Guid
  +version: long
  +name: string
}
interface IToastService {
  +show(toast: Toast): void
}
class LeadCoverageView {
  +refresh: InputSignal<number>
  -coverage: ResourceRef<LeadCoverage>
  +state: Signal<SectionState<LeadCoverage>>
  +retry(): void
}
class WorkspaceProgressView {
  +refresh: InputSignal<number>
  +canCreateProject: InputSignal<bool>
  +newProjectRequested: OutputEmitterRef<void>
  -progress: ResourceRef<WorkspaceProgressPage>
  +state: Signal<SectionState<WorkspaceProgressPage>>
  +retry(): void
}
class ActiveSprintSummaryView {
  +refresh: InputSignal<number>
  -sprints: ResourceRef<ActiveSprintSummaryPage>
  +state: Signal<SectionState<ActiveSprintSummaryPage>>
  +retry(): void
}
note bottom of LeadCoverageView
  Each view instance owns its resource; state is computed
  from it. The resource reads on creation (every /home
  activation) and on a refresh change, retry() calls
  reload(), and destroy aborts.
  No cross-view cache. Stale responses change nothing.
end note
interface "ResourceRef<T>" as ResourceRef {
  +value: Signal<T | undefined>
  +status: Signal<'loading' | 'resolved' | 'error'>
  +error: Signal<unknown>
  +reload(): void
}
note right of ResourceRef
  Shared type, defined once in api;
  shown here for reference only.
end note
class "SectionState<T>" as SectionState {
  +status: SectionStatus
  +value: T?
  +referenceId: string?
}
enum SectionStatus {
  Loading
  Ready
  Empty
  Failed
}
interface IHomeService {
  +leadCoverageResource(query: () => GetLeadCoverageQuery | undefined): ResourceRef<LeadCoverage>
  +workspaceProgressResource(query: () => GetWorkspaceProgressQuery | undefined): ResourceRef<WorkspaceProgressPage>
  +activeSprintSummaryResource(query: () => GetActiveSprintSummaryQuery | undefined): ResourceRef<ActiveSprintSummaryPage>
}
class HomeService {
  -http: HttpClient
}
note right of HomeService
  No shared results: each call creates a resource in
  the caller's injection context; HTTP and the
  observable-to-signal conversion stay inside.
end note
class HomeController {
  -sender: ISender
}
interface IMissionControlDataSession {
  +LoadLeadCoverageAsync(ct: CancellationToken): Task<LeadCoverage>
  +ListWorkspaceProgressAsync(page: int, pageSize: int, ct: CancellationToken): Task<WorkspaceProgressPage>
  +ListActiveSprintSummariesAsync(page: int, pageSize: int, ct: CancellationToken): Task<ActiveSprintSummaryPage>
}
note right of IMissionControlDataSession
  Each read: one statement (window count for the total)
  or one explicit snapshot-isolation read transaction.
end note
HomePage --> LeadCoverageView : composes
HomePage --> WorkspaceProgressView : composes; canCreateProject in, newProjectRequested out
HomePage --> ProjectFormDialog : opens (create); Saved and unconfirmed
ProjectFormDialog ..> SavedWorkspaceResult : Saved carries
HomePage ..> IToastService : inject TOAST_SERVICE; Project created toast
HomePage --> ActiveSprintSummaryView : composes
LeadCoverageView ..> IHomeService : inject HOME_SERVICE
WorkspaceProgressView ..> IHomeService : inject HOME_SERVICE
ActiveSprintSummaryView ..> IHomeService : inject HOME_SERVICE
LeadCoverageView --> SectionState
WorkspaceProgressView --> SectionState
ActiveSprintSummaryView --> SectionState
LeadCoverageView --> ResourceRef : owns
WorkspaceProgressView --> ResourceRef : owns
ActiveSprintSummaryView --> ResourceRef : owns
SectionState --> SectionStatus
IHomeService <|.. HomeService

class GetLeadCoverageQuery
note right of GetLeadCoverageQuery
  No parameters: always returns all five
  categories, zero counts included (L2-028.1).
end note
class GetLeadCoverageQueryHandler {
  +handle(request: GetLeadCoverageQuery, ct: CancellationToken): Task<LeadCoverage>
}
class LeadCoverage {
  +categories: CategoryCount[]
  +totalCount: int
}
class CategoryCount {
  +category: LeadCategory
  +count: int
}
HomeController ..> GetLeadCoverageQuery : dispatches
GetLeadCoverageQueryHandler ..> GetLeadCoverageQuery : handles
GetLeadCoverageQueryHandler --> LeadCoverage : projects
GetLeadCoverageQueryHandler ..> IMissionControlDataSession : uses
LeadCoverage *-- "5" CategoryCount

class GetWorkspaceProgressQuery {
  +page: int
  +pageSize: int
}
class GetWorkspaceProgressQueryHandler {
  +handle(request: GetWorkspaceProgressQuery, ct: CancellationToken): Task<WorkspaceProgressPage>
}
class WorkspaceProgressPage {
  +items: WorkspaceProgress[]
  +totalCount: int
}
class WorkspaceProgress {
  +workspaceId: Guid
  +name: string
  +mode: DeliveryMode
  +responsibleLeadId: Guid?
  +responsibleLeadName: string?
  +activeSprint: SprintPeriod?
  +nextPlannedSprint: SprintPeriod?
  +workItemTotal: int
  +counts: TypeStatusCount[]
}
class TypeStatusCount {
  +type: WorkItemType
  +status: WorkStatus
  +count: int
}
class SprintPeriod {
  +sprintId: Guid
  +name: string
  +startDate: DateOnly
  +endDate: DateOnly
}
HomeController ..> GetWorkspaceProgressQuery : dispatches
GetWorkspaceProgressQueryHandler ..> GetWorkspaceProgressQuery : handles
GetWorkspaceProgressQueryHandler --> WorkspaceProgressPage : projects
GetWorkspaceProgressQueryHandler ..> IMissionControlDataSession : uses
WorkspaceProgressPage *-- WorkspaceProgress
WorkspaceProgress *-- "12" TypeStatusCount
WorkspaceProgress --> SprintPeriod

class GetActiveSprintSummaryQuery {
  +page: int
  +pageSize: int
}
class GetActiveSprintSummaryQueryHandler {
  +handle(request: GetActiveSprintSummaryQuery, ct: CancellationToken): Task<ActiveSprintSummaryPage>
}
class ActiveSprintSummaryPage {
  +items: ActiveSprintSummary[]
  +totalCount: int
}
class ActiveSprintSummary {
  +sprintId: Guid
  +name: string
  +workspaceId: Guid
  +workspaceName: string
  +goal: string?
  +startDate: DateOnly
  +endDate: DateOnly
  +storiesTotal: int
  +storyCounts: StatusCount[]
}
class StatusCount {
  +status: WorkStatus
  +count: int
}
HomeController ..> GetActiveSprintSummaryQuery : dispatches
GetActiveSprintSummaryQueryHandler ..> GetActiveSprintSummaryQuery : handles
GetActiveSprintSummaryQueryHandler --> ActiveSprintSummaryPage : projects
GetActiveSprintSummaryQueryHandler ..> IMissionControlDataSession : uses
ActiveSprintSummaryPage *-- ActiveSprintSummary
ActiveSprintSummary *-- "3" StatusCount

@enduml
