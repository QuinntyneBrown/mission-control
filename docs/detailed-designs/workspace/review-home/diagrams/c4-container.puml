@startuml
!include <C4/C4_Container>
LAYOUT_WITH_LEGEND()
title Containers - Review home coverage and progress
Person(actor, "Authorized user", "Review home coverage and progress")
System_Boundary(mc, "Mission Control") {
  Container(web, "Mission Control web client", "Angular", "Review home coverage and progress")
  Container(api, "MissionControl.Api", ".NET", "Authorized application handlers")
