@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
title Behavior - Read active sprint summaries
actor "Authorized user" as actor
box "Frontend - Mission Control application" #E0F2FE
  participant "HomePage / ActiveSprintSummaryView" as page
  participant "IHomeService / HomeService" as client
end box
box "Backend - MissionControl.Api" #D1FADF
  participant "CurrentAccountAuthorization" as access
  participant "HomeController" as ctrl
end box
box "Backend - MissionControl.Application" #ECFDF3
  participant "ValidationBehavior" as validation
  participant "GetActiveSprintSummaryQueryHandler" as handler
  participant "ActiveSprintSummaryPage" as projection
end box
box "Backend - MissionControl.Infrastructure" #FFF4E5
  database "Mission Control SQL" as db
end box
actor -> page : Open /home, or Retry in Active sprints
page -> page : state = Loading; section keeps its shape with skeletons (L2-032.1)
page -> client : sprints(GetActiveSprintSummaryQuery page 1, pageSize 25)
client -> access : GET /api/home/active-sprints?page=1&pageSize=25
access -> access : L2-002 validate signature, issuer, audience, subject, expiry
access -> db : Read current status, role and credential version
db --> access : Current account access
alt 401: token absent, invalid or expired; account deactivated or credential version changed
  access --> client : 401 ProblemDetails; denial audited without payloads
  client -> client : Clear in-memory session and protected caches (L2-003)
  client --> page : Unauthenticated
  page --> actor : AuthenticationGuard stores /home; sign-in shows "Your session ended"
else Authenticated (profile P: every active role reads sprints, so no 403 path)
  access -> ctrl : Authenticated request
  ctrl -> validation : Send GetActiveSprintSummaryQuery through MediatR 12.5.0
  validation -> validation : L2-045 page at least 1; pageSize 1 to 100 (default 25)
  alt 400: page or pageSize out of range
    validation --> ctrl : Field errors with page-size message; nothing read (L2-045.2)
    ctrl --> client : 400 Validation ProblemDetails
    client --> page : state = Failed
    page --> actor : Section alert with Retry (HomePage itself always sends pageSize 25)
  else Valid request
    validation -> handler : Handle GetActiveSprintSummaryQuery
    handler -> db : L2-028 one read transaction: Active sprints of Scrum workspaces ordered by workspace name then sprint ID, total count, and member stories counted by status
    alt SQL unavailable or unexpected failure
      db --> handler : Exception
      handler --> ctrl : Unhandled failure
      ctrl --> client : 500 with correlation ID; diagnostic record written (L2-043)
      client --> page : state = Failed(referenceId)
      page --> actor : Section alert with reference ID and Retry; other sections stay
    else Sprints read
      db --> handler : Active sprints, total count, story counts by status
      handler -> projection : Fill absent statuses with 0; sprint name, workspace, dates and goal
      projection --> handler : ActiveSprintSummaryPage
      handler --> ctrl : ActiveSprintSummaryPage
      ctrl --> client : 200 ActiveSprintSummaryPage
      alt totalCount = 0
        client --> page : state = Empty
        page --> actor : "No active sprints" with View sprints (no-active-sprints)
      else Active sprints exist
        client --> page : state = Ready(ActiveSprintSummaryPage)
        page --> actor : Sprint cards; each sprint name opens its sprint board (L2-028.2)
      end
    end
  end
end
note over page, db
One active sprint per workspace; Kanban workspaces cannot hold an Active sprint (L2-027).
Story counts cover every member story, not a loaded batch (L2-045).
end note
@enduml
