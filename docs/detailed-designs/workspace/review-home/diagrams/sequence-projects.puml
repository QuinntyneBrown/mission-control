@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam maxMessageSize 300
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
title Behavior - Read workspace progress summaries
actor "Authorized user" as actor
box "Frontend - Mission Control application" #E0F2FE
  participant "HomePage / WorkspaceProgressView" as page
  participant "IHomeService / HomeService" as client
end box
box "Backend - MissionControl.Api" #D1FADF
  participant "CurrentAccountAuthorization" as access
  participant "HomeController" as ctrl
end box
box "Backend - MissionControl.Application" #ECFDF3
  participant "ValidationBehavior" as validation
  participant "GetWorkspaceProgressQueryHandler" as handler
  participant "WorkspaceProgressPage" as projection
end box
box "Backend - MissionControl.Infrastructure" #FFF4E5
  database "Mission Control SQL" as db
end box
actor -> page : Open /home, Retry in Projects, or a project create left unconfirmed (refresh change)
page -> page : state = Loading; section keeps its shape with skeletons (L2-032.1)
page -> client : workspaceProgressResource(() => GetWorkspaceProgressQuery { page 1, pageSize 25 }) reads on view creation, or reload() on Retry or a refresh change
client -> access : GET /api/home/projects?page=1&pageSize=25
alt No response: the connection dropped or the request timed out
  client --> page : state = Failed, no reference ID; sessionInterceptor sets offline, so ApplicationShell shows the offline banner
  page --> actor : Section alert with Retry and no reference ID; other sections stay
else Response received
access -> access : L2-002 validate signature, issuer, audience, subject, expiry
access -> db : Read current status, role and credential version
db --> access : Current account access
alt 401: token absent, invalid or expired; account deactivated or credential version changed
  access --> client : 401 ProblemDetails; denial audited without payloads
  alt Request's generation is still current
    client -> client : sessionInterceptor calls end(Unauthorized), once (L2-003)
    client --> page : Resource keeps its state (401); section unchanged
    page --> actor : ApplicationShell stores /home and opens sign-in: "Your session ended"
  else Session already ended (another section's 401 came first)
    client --> page : Discarded: the read resource keeps its state; no second session end
  end
else Authenticated (profile P: every active role reads workspaces and work, so no 403 path)
  access -> ctrl : Authenticated request
  ctrl -> validation : Send GetWorkspaceProgressQuery through MediatR 12.5.0
  validation -> validation : L2-045 page at least 1; pageSize 1 to 100 (default 25)
  alt 400: page or pageSize out of range
    validation --> ctrl : Field errors with page-size message; nothing read (L2-045.2)
    ctrl --> client : 400 Validation ProblemDetails
    client --> page : state = Failed, no reference ID
    page --> actor : Section alert; only a direct API call can reach this path, because Home always sends page 1 and pageSize 25
  else Valid request
    validation -> handler : Handle GetWorkspaceProgressQuery
    handler -> db : L2-028 one statement (window count) or one explicit snapshot read transaction: workspace page ordered by name then ID, total workspace count, and work items of those workspaces counted by type and status
    alt SQL unavailable or unexpected failure
      db --> handler : Exception
      handler --> ctrl : Unhandled failure
      ctrl --> client : 500; X-Correlation-ID header carries the reference ID; diagnostic record written (L2-043)
      client --> page : state = Failed(referenceId)
      page --> actor : "We couldn't load projects" with reference ID and Retry; Leads and Sprints stay (section-error)
    else Page and counts read
      db --> handler : Workspaces, total count, grouped counts (each item counted once)
      handler -> projection : Fill absent type and status pairs with 0; attach workItemTotal and the active and next planned sprint
      projection --> handler : WorkspaceProgressPage
      handler --> ctrl : WorkspaceProgressPage
      ctrl --> client : 200 WorkspaceProgressPage
      alt totalCount = 0
        client --> page : state = Empty
        page --> actor : "No projects yet"; New project when canCreateProject (newProjectRequested: HomePage opens ProjectFormDialog; on Saved(SavedWorkspaceResult) it shows the "Project created" toast naming the project and opens /projects/:workspaceId; while the dialog stays open, its unconfirmed output increments HomePage's counter at once, so this section rereads before the project is saved again), otherwise an explanation beside the collaborator notice (L2-032.2)
      else Workspaces exist
        client --> page : state = Ready(WorkspaceProgressPage)
        page --> actor : Name, mode, responsible lead, sprint, work-item total and count table per project, no description; counts open the filtered work list (L2-028.2)
      end
    end
  end
end
end
note over page, db
Counts cover every persisted work item, not the loaded page (L2-028.1, L2-045).
The hint reads "N projects - View all projects", or "Showing 25 of N - View all projects" when totalCount exceeds the page.
A type's Total column adds its three status counts from the same response.
Sections may reflect different instants. A response that arrives after the session ended is discarded.
end note
@enduml
