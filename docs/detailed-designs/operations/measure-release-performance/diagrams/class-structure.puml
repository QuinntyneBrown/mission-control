@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
title Class structure - Measure release workflow performance
class PerformanceResult {
  +operationClass: string
  +count: long
  +p95ServerMilliseconds: decimal
  +unexpected5xx: long
  +integrityFailures: long
  +environmentManifest: string
}
class PerformanceHarness {
  +run(configuration: OperationConfiguration): PerformanceResult
}
class OperationConfiguration {
  +environment: string
  +sqlProvider: string
  +externalSecretsAvailable: bool
}
PerformanceHarness ..> OperationConfiguration : consumes
PerformanceHarness --> PerformanceResult : records outcome
@enduml
