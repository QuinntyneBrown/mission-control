@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components - Measure release workflow performance
Container_Boundary(ops, "backend/src/MissionControl.Operations") {
  Component(console, "OperationsConsole", "Entry point / Microsoft.Extensions Hosting", "Binds PerformanceOptions; runs one verb")
  Component(fixture, "SeedPerformanceFixtureOperation", "fixture verb", "Builds the uniform or large/hot fixture through existing endpoints")
  Component(load, "MeasureApiLoadOperation", "load verb", "Open-loop LoadScenario, correlation-ID join, per-class results, invariant reads")
}
Container_Boundary(e2e, "e2e/performance") {
  Component(cold, "MeasureColdViewsOperation", "Playwright library script", "Two fresh contexts per run; intervals 1-3 and full journey")
  Component(retention, "MeasureRetentionOperation", "Playwright library script", "Rendered counts and heap trend on the large workspace")
  Component(po, "Page objects", "Shared from e2e/page-objects", "Sign-in, usable checks, rendered counts")
}
Container_Boundary(apiBoundary, "backend/src/MissionControl.Api") {
  Component(timing, "RequestTimingMiddleware", "Outermost middleware / RequestTimingOptions", "Entry to completed response; diagnostic Server-Timing")
  Component(endpoints, "Existing feature endpoints", "Thin controllers / MediatR 12.5.0", "Reads and permitted writes; lock wait and SQL command tags")
  Component(timingRecords, "Restricted timing records", "Structured diagnostics", "RequestTimingRecord per request, keyed by correlation ID")
}
Container(web, "Mission Control web app", "Angular production build", "HTTP adapters")
ContainerDb(db, "Isolated SQL target", "Selected SQL provider", "Uniform or large/hot fixture")
Container(records, "docs/operations/performance", "JSON", "EnvironmentManifest and results")
Rel(console, fixture, "fixture")
Rel(console, load, "load")
Rel(fixture, timing, "Creates fixture records", "HTTPS")
Rel(load, timing, "Scenario workload and invariant reads", "HTTPS")
Rel(timing, endpoints, "Times the pipeline")
Rel(timing, timingRecords, "Writes on response completed")
Rel(load, timingRecords, "Reads JSON timing lines as TimingRecordEntry; joins by correlation ID")
Rel(endpoints, db, "Parameterized SQL")
Rel(cold, po, "Signs in; navigates; waits until usable")
Rel(retention, po, "Load more, expand/collapse, route changes")
Rel(po, web, "Chromium interactions", "HTTPS")
Rel(web, timing, "Production HTTP adapters", "HTTPS")
Rel(load, records, "PerformanceResult")
Rel(cold, records, "ColdViewResult")
Rel(retention, records, "RetentionResult")
@enduml
