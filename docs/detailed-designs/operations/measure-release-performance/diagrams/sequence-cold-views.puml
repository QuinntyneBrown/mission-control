@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
title Behavior - Measure cold Chromium view readiness
actor "Release operator" as actor
box "Release tooling - e2e/performance" #E0F2FE
  participant "MeasureColdViewsOperation" as runner
  participant "Page objects\n(e2e/page-objects)" as po
end box
box "Browser" #F2F4F7
  participant "Chromium\n(fresh context per run)" as browser
end box
box "Frontend - production build" #EEF4FF
  participant "Mission Control web app\n(production build, HTTP adapters)" as app
end box
box "Backend - MissionControl.Api (performance instance)" #D1FADF
  participant "Existing feature endpoints" as api
end box
box "Selected SQL provider" #FFF4E5
  database "Isolated SQL target\n(L2-046 fixture)" as db
end box
box "Release records" #ECFDF3
  participant "ColdViewResult" as result
end box
actor -> runner : Home, Leads, Backlog, Active board (EnvironmentManifest)
runner -> api : GET /health/ready
break Readiness 503
  api --> runner : 503
  runner -> result : Outcome NotRun for every view
  runner --> actor : Restore the fixture and restart the API
end
loop 4 views x 30 runs
  runner -> browser : New context: empty cache and storage; 20 Mbps / 40 ms profile
  runner -> po : Open the view's direct route
  po -> browser : Navigate
  browser -> app : Load app shell (uncached)
  app --> browser : Sign-in page (no in-memory session)
  runner -> po : Sign in with a session account; timer starts at submission
  po -> browser : Fill and submit
  browser -> app : Submit sign-in
  app -> api : POST /api/sessions
  api -> db : Read account
  db --> api : Account
  api --> app : Access token (memory only)
  app -> app : Route to the view; load its bundle (uncached)
  app -> api : View queries (page size 25; board batches up to 100)
  api -> db : Parameterized reads
  db --> api : Rows and total counts
  api --> app : Typed results
  app --> browser : Render content and controls
  runner -> po : Wait until essential content and controls are usable
  po -> browser : Check view-specific content and enabled controls
  alt Usable within 30 seconds
    po --> runner : Usable; timer stops
  else Error state, sign-in failure, or not usable within 30 seconds
    po --> runner : Failed run; recorded, never dropped
  end
end
runner -> runner : Per view: runs, failed runs, p95 usable milliseconds
runner -> result : L2-046.2 ColdViewResult per view with manifest
alt Any failed run or any view p95 > 2.5 seconds
  runner --> actor : Outcome Failed; views named; no passing claim
else Manifest differs from the L2-046 profile
  runner --> actor : Outcome OtherEnvironment; never labeled passing
else Every view within 2.5 seconds at p95
  runner --> actor : Outcome Passed for this run
end
@enduml
