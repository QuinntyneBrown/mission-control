@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
title Behavior - Measure proposed concurrent API workload
actor "Release operator" as actor
box "Frontend - Operations console / Chromium harness" #E0F2FE
  participant "PerformanceHarness" as handler
end box
box "Backend - MissionControl.Api existing endpoints" #D1FADF
  participant "Existing feature API" as api
end box
box "Backend - Application / operational verification" #ECFDF3
  participant "PerformanceResult" as entity
end box
box "Backend - Infrastructure / selected SQL provider" #FFF4E5
  database "Verified isolated SQL target / source backup" as db
end box
actor -> handler : Measure proposed concurrent API workload
  handler -> db : Prepare isolated L2-046 fixture and account permissions
  db --> handler : Baseline fixture
  handler -> entity : Execute 60% read / 40% write workload; collect per-class server durations
  entity --> handler : Percentiles, operation counts and failures
  handler -> db : Verify committed relationships and ordering after load
alt Unexpected 5xx, integrity failure, or exceeded per-class p95
  handler -> entity : Record failure; leave readiness/result unresolved
  entity --> handler : Failed run record
  handler --> actor : Failure and recovery guidance; no passing claim
else Procedure succeeds
  handler -> api : Verify through existing feature endpoints / health / page objects
  api -> db : Read or commit representative protected behavior
  db --> api : Persisted result
  api --> handler : Result without secrets
  handler -> entity : Record exact environment, timings and verified outcome
  entity --> handler : Completed run record
  handler --> actor : Rehearsal / measurement result
end
@enduml
