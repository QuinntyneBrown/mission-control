@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
set separator none
title Class structure - Rehearse backup and restore
package "backend/src/MissionControl.Operations" {
  class OperationsConsole {
    +main(args: string[]): int
  }
  class CaptureBackupOperation {
    +run(options: RecoveryOptions): RecoveryRecord
  }
  class RestoreBackupOperation {
    +run(options: RecoveryOptions, capture: RecoveryRecord): RecoveryRecord
  }
  interface IBackupProvider {
    +backup(sourceConnectionName: string, artifactLocation: string): void
    +verify(artifactLocation: string): string
    +restore(artifactLocation: string, targetConnectionName: string): void
  }
  interface IDataFingerprintReader {
    +read(connectionName: string): DataFingerprint
  }
  class RecoveryApiProbe {
    +verify(apiBaseUrl: string, samples: string[]): string[]
  }
  class RecoveryOptions {
    +sourceConnectionName: string
    +targetConnectionName: string
    +artifactStorage: string
    +recoveryApiBaseUrl: string
    +recordsFolder: string
  }
  class RecoveryRecord {
    +operation: string
    +backupPoint: DateTimeOffset
    +artifactLocation: string
    +artifactChecksum: string
    +sourceEnvironment: string
    +targetEnvironment: string?
    +startedAtUtc: DateTimeOffset
    +endedAtUtc: DateTimeOffset?
    +fingerprint: DataFingerprint
    +verificationResults: string[]
    +failures: string[]
    +outcome: RecoveryOutcome
  }
  class DataFingerprint {
    +tableCounts: Map<string, long>
    +orderedDigests: Map<string, string>
    +samples: string[]
  }
  enum RecoveryOutcome {
    Captured
    Passed
    Failed
  }
}
note bottom of RecoveryOptions
Credentials and the changed administrator
password come from external secret
configuration; no record stores them.
end note
OperationsConsole ..> RecoveryOptions : binds
OperationsConsole --> CaptureBackupOperation : backup
OperationsConsole --> RestoreBackupOperation : restore
CaptureBackupOperation --> IBackupProvider : backs up, verifies
CaptureBackupOperation --> IDataFingerprintReader : source, read-only
RestoreBackupOperation --> IBackupProvider : checksum, restore
RestoreBackupOperation --> IDataFingerprintReader : target, read-only
RestoreBackupOperation --> RecoveryApiProbe : API checks
CaptureBackupOperation ..> RecoveryRecord : creates
RestoreBackupOperation ..> RecoveryRecord : reads capture, creates
RecoveryRecord *-- DataFingerprint
RecoveryRecord --> RecoveryOutcome
@enduml
