@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components - Rehearse backup and restore
Container_Boundary(ops, "backend/src/MissionControl.Operations") {
  Component(console, "OperationsConsole", "Entry point / Microsoft.Extensions Hosting", "Binds RecoveryOptions; runs one verb; writes RecoveryRecord")
  Component(capture, "CaptureBackupOperation", "backup verb", "Read-only fingerprint, provider backup, artifact verification")
  Component(restore, "RestoreBackupOperation", "restore verb", "Target guard, provider restore, fingerprint comparison")
  Component(provider, "IBackupProvider", "Port / provider adapter <TO SUPPLY>", "Backup, verify, checksum, and restore commands")
  Component(fingerprint, "IDataFingerprintReader", "Port / read-only SQL adapter", "Counts, ordered digests, sample records")
  Component(probe, "RecoveryApiProbe", "Typed HttpClient", "Readiness, administrator sign-in, sample reads")
}
ContainerDb(source, "Source SQL", "Selected SQL provider", "Read-only during capture")
Container_Ext(storage, "Backup storage", "Facility <TO SUPPLY>", "Backup artifacts")
ContainerDb(target, "Isolated SQL target", "Selected SQL provider", "Restored rehearsal data")
Container(api, "MissionControl.Api (recovery instance)", ".NET", "Existing endpoints")
Container(records, "docs/operations", "JSON / Markdown", "RecoveryRecord files and recovery-runbook.md")
Rel(console, capture, "backup")
Rel(console, restore, "restore")
Rel(console, records, "Writes RecoveryRecord")
Rel(capture, fingerprint, "Reads source fingerprint")
Rel(capture, provider, "Backs up and verifies")
Rel(restore, provider, "Checks checksum and restores")
Rel(restore, fingerprint, "Reads target fingerprint")
Rel(restore, probe, "Verifies through the API")
Rel(fingerprint, source, "Read-only transaction", "SQL")
Rel(fingerprint, target, "Read-only transaction", "SQL")
Rel(provider, source, "Backup command (reads only)")
Rel(provider, storage, "Writes / verifies / reads artifact")
Rel(provider, target, "Restore command")
Rel(probe, api, "Existing endpoints", "HTTPS")
@enduml
