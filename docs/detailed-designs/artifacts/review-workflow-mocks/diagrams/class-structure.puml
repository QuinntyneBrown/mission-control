@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
title Artifact structure - Review workflow mock artifacts
class MockScreen {
  +path: string
  +title: string
  +requirementIds: string[]
  +states: MockState[]
}
class ArtifactCatalog {
  +title: string
  +paths: string[]
  +open(path: string): void
}
class ReviewProfile {
  +viewportWidth: int
  +textZoomPercent: int
}
ArtifactCatalog "1" o-- "*" MockScreen : lists
ArtifactCatalog ..> ReviewProfile : reviews at
class MockState {
  +id: string
  +label: string
  +designNote: string
}
MockScreen "1" *-- "*" MockState : owns examples
@enduml
