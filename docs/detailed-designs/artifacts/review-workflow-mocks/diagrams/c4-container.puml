@startuml
!include <C4/C4_Container>
LAYOUT_WITH_LEGEND()
title Containers - Review workflow mock artifacts
Person(reviewer, "Design reviewer", "Reviews at stated viewport widths")
System_Boundary(artifact, "Review workflow mock artifacts") {
  Container(source, "docs/mocks/", "HTML / CSS / JavaScript", "Static sources and token values")
  Container(site, "Independent static review site", "Browser", "Catalog, examples, and review states")
}
Rel(source, site, "Builds or loads offline")
Rel(reviewer, site, "Opens and resizes")
@enduml
