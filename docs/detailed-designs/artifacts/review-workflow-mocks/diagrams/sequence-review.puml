@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
title Manual review - Review workflow mock artifacts
actor "Design reviewer" as reviewer
box "Frontend - Standalone static artifact" #E0F2FE
  participant "ArtifactCatalog\n(index.html / viewer.html)" as catalog
  participant "MockScreen / MockState" as example
  participant "--mc- token stylesheet" as tokens
end box
box "Backend - Application runtime excluded" #D1FADF
  participant "No API or SQL dependency" as excluded
end box
reviewer -> catalog : ReviewWorkflowMocks: open index.html offline
catalog -> example : Select a mock and #state=<id> in the viewer
example -> tokens : Read visual roles
tokens --> example : Token values
example --> catalog : Static rendering under the visible MOCK bar
catalog --> reviewer : L2-048 review at 375 / 768 / 1440, plus profile R widths (320-1920)
alt Listed workflow has no named screen or interaction
  reviewer -> catalog : Record L2-048.1 gap
  catalog --> reviewer : New mock added to build-index.mjs; index regenerated
else Overlapping controls or page-level horizontal scroll at a width
  reviewer -> catalog : Record L2-048.2 issue with the failing width
  catalog --> reviewer : Shared token-based style revised; recheck at that width
else MOCK label missing, non-fictitious data, or a live send or write
  reviewer -> catalog : Record L2-048.3 issue
  catalog --> reviewer : Label restored; example.org, 555-01xx, or +44 20 7946 0xxx data; action simulated
else Empty, loading, validation, failure, or success state missing
  reviewer -> catalog : Record L2-048.4 gap
  catalog --> reviewer : State option, data-when markup, and design note added
else Tests or ATDD introduced for the mocks
  reviewer -> catalog : Record L2-048.5 issue; remove them
  catalog --> reviewer : Mocks remain manual-review only
else Review criteria satisfied
  reviewer -> catalog : Record manual review outcome
  catalog --> reviewer : Artifact remains static; no ATDD or tests
end
note over catalog, excluded
No authentication, network mutation, or application database persistence occurs.
end note
@enduml
