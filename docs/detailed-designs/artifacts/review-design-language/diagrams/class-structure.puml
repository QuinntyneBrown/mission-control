@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
title Artifact structure - Review the standalone design language
class DesignToken {
  +name: string
  +family: string
  +value: string
  +exampleIds: string[]
}
class NamedBreakpoint {
  +name: string
  +condition: string
}
class ArtifactCatalog {
  +title: string
  +paths: string[]
  +open(path: string): void
}
class ReviewProfile {
  +viewportWidth: int
  +viewportHeight: int
  +textZoomPercent: int
}
class MirroredFile {
  +destinationPath: string
  +sourcePath: string
  +sourceVersion: string
  +sourceCommit: string
}
ArtifactCatalog "1" o-- "*" DesignToken : lists
ArtifactCatalog "1" o-- "*" NamedBreakpoint : documents
ArtifactCatalog ..> ReviewProfile : reviews at profile R widths
MirroredFile ..> DesignToken : copies dist/tokens.css
MirroredFile ..> NamedBreakpoint : copies dist/_breakpoints.scss
note right of NamedBreakpoint
Literal widths live only here;
component styles use the names.
end note
note bottom of MirroredFile
Written only by sync-tokens with a header naming
sourceVersion and sourceCommit. Review rebuilds
at that commit, resyncs, and expects no change.
end note
@enduml
