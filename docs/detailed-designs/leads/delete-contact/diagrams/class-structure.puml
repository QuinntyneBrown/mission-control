@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
title Class structure - Delete an unreferenced lead contact
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
class LeadDetailPage {
  +routeContext: Signal<RouteContext>
  +openDialog(): void
}
class LeadDirectoryPage {
  +routeContext: Signal<RouteContext>
  +openDialog(): void
}
class LeadDeleteDialog {
  +lead: LeadSummary
  +blockingWorkspaces: Signal<ReferencingWorkspace[]>
  +confirm(): void
  +cancel(): void
}
class LeadView {
  +state: Signal<FeatureState>
  +submit(): void
}
interface ILeadService {
  +delete(request: DeleteLeadCommand): Promise<FeatureResult>
}
class LeadService {
  -http: HttpClient
}
class LeadsController {
  -sender: ISender
}
class LeadContact {
  +id: Guid
  +firstName: string
  +lastName: string
  +version: long
  +checkDeletion(referencing: ReferencingWorkspace[]): void
}
interface IMissionControlDataSession {
  +query(specification): Task<ReadResult>
  +commit(expectedVersion: long): Task<void>
}
class MissionControlDataSession {
  -connection: DbConnection
}
LeadDetailPage --> LeadView : composes
LeadDirectoryPage --> LeadView : composes
LeadDetailPage ..> LeadDeleteDialog : opens; blocked at once when\nresponsibleWorkspaces is not empty
LeadDirectoryPage ..> LeadDeleteDialog : opens confirmation
LeadDeleteDialog --> LeadView : composes
LeadView ..> ILeadService : inject token
ILeadService <|.. LeadService
IMissionControlDataSession <|.. MissionControlDataSession
class DeleteLeadCommand {
  +id: Guid
}
class DeleteLeadCommandHandler {
  +handle(request: DeleteLeadCommand): Task<FeatureResult>
}
class ReferencingWorkspace {
  +id: Guid
  +name: string
}
class LeadReferencedProblem {
  +status: 409
  +detail: string
  +workspaces: ReferencingWorkspace[]
}
note bottom of LeadReferencedProblem
  detail: reassign or remove the responsible lead
  in each listed workspace before deleting.
end note
LeadReferencedProblem *-- ReferencingWorkspace
LeadsController ..> DeleteLeadCommand : dispatches
DeleteLeadCommandHandler ..> DeleteLeadCommand : handles
DeleteLeadCommandHandler --> LeadContact : loads / applies
DeleteLeadCommandHandler ..> LeadReferencedProblem : 409 when referenced
DeleteLeadCommandHandler ..> IMissionControlDataSession : uses

enum LeadCategory {
  Create
  Communication
  City
  Prayer
  Event
}
LeadContact --> LeadCategory : one responsibility
@enduml
