@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
title Behavior - Confirm and delete a lead
actor "Administrator" as actor
box "Frontend - Mission Control application" #E0F2FE
  participant "LeadDetailPage or LeadDirectoryPage\nLeadDeleteDialog / LeadView" as page
  participant "ILeadService / LeadService" as client
end box
box "Backend - MissionControl.Api" #D1FADF
  participant "CurrentAccountAuthorization" as access
  participant "LeadsController" as ctrl
end box
box "Backend - MissionControl.Application and Domain" #ECFDF3
  participant "ValidationBehavior" as validation
  participant "DeleteLeadCommandHandler" as handler
  participant "LeadContact" as entity
end box
box "Backend - MissionControl.Infrastructure" #FFF4E5
  database "Mission Control SQL" as db
end box
actor -> page : Select Delete on lead details or a directory row
alt Loaded lead details already list responsible workspaces
  page --> actor : Open blocked explanation with project links; no request; no delete or retry
else No known reference
  page --> actor : Open LeadDeleteDialog naming the lead and category; focus Cancel
  alt Cancel or Escape
    page --> actor : Close dialog; no request; focus returns to Delete
  else Confirm
    page -> page : Disable repeat confirmation; show deleting progress
    page -> client : Build typed DeleteLeadCommand (lead ID only)
    client -> access : DELETE /api/leads/{id}
    access -> access : L2-002 validate signature, issuer, audience, subject, expiry
    access -> db : Read current status, role and credential version
    db --> access : Current account access
    alt Missing, invalid, or expired JWT; inactive account
      access --> client : 401; audit denial without payloads
      client --> page : Clear in-memory session; require login; nothing deleted
    else Collaborator (no contact mutation in profile P)
      access --> client : 403; audit denial without payloads
      client --> page : Close dialog; show that only administrators can delete leads; nothing deleted
    else Administrator
      access -> ctrl : Authorized request
      ctrl -> validation : Send DeleteLeadCommand through MediatR 12.5.0
      validation -> handler : Handle DeleteLeadCommand
      handler -> db : Begin transaction; load lead and workspaces naming it responsible (ID, name)
      db --> handler : Contact or none; referencing workspaces
      alt Lead missing (already deleted)
        handler --> ctrl : 404; nothing deleted
        ctrl --> client : NotFound ProblemDetails
        client --> page : Close dialog; reload directory without the lead; announce it was already deleted
      else Lead found
        handler -> entity : L2-012 checkDeletion(referencing workspaces)
        alt Workspaces reference the lead
          entity --> handler : Rejected: still responsible
          handler --> ctrl : 409 listing referencing workspaces (ID, name) with reassignment guidance; nothing deleted
          ctrl --> client : Conflict ProblemDetails
          client --> page : Switch to blocked explanation with project links; no delete or retry
        else Unreferenced
          entity --> handler : Deletion permitted
          handler -> db : L2-039 / L2-040 delete only the contact row and append success audit; one transaction
          alt Restrictive FK rejects a racing owner assignment
            db --> handler : Roll back delete and audit; read the new referencing workspaces
            handler --> ctrl : 409 listing referencing workspaces; nothing deleted
            ctrl --> client : Conflict ProblemDetails
            client --> page : Switch to blocked explanation with project links; no delete or retry
          else Commit fails unexpectedly
            db --> handler : Roll back delete and audit
            handler --> ctrl : Generic 500 with correlation ID
            ctrl --> client : Failure; nothing deleted
            client --> page : Keep dialog open; show reference ID; Delete lead retries
          else Commit succeeds
            db --> handler : Contact row removed; accounts, work, and sprint history untouched
            handler --> ctrl : 204 No Content
            ctrl --> client : Success response
            client --> page : Close dialog; reload directory and counts without the lead; announce deletion
            page --> actor : Focus moves to the directory heading
          end
        end
      end
    end
  end
end
note over ctrl, db
Unexpected failures return generic 500 plus correlation ID (L2-043).
Diagnostics exclude secrets and contact payloads.
end note
@enduml
