@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
title Behavior - Create a lead
actor "Administrator" as actor
box "Frontend - Mission Control application" #E0F2FE
  participant "LeadFormDialog / LeadView" as page
  participant "ILeadService / LeadService" as client
end box
box "Backend - MissionControl.Api" #D1FADF
  participant "CurrentAccountAuthorization" as access
  participant "LeadsController" as ctrl
end box
box "Backend - MissionControl.Application and Domain" #ECFDF3
  participant "ValidationBehavior" as validation
  participant "CreateLeadCommandHandler" as handler
  participant "LeadContact" as entity
end box
box "Backend - MissionControl.Infrastructure" #FFF4E5
  database "Mission Control SQL" as db
end box
actor -> page : Enter lead details and save
page -> page : Disable repeat submission; show saving progress
page -> client : Build typed CreateLeadCommand
client -> access : POST /api/leads
access -> access : L2-002 validate signature, issuer, audience, subject, expiry
access -> db : Read current status, role and credential version
db --> access : Current account access
alt Missing, invalid, or expired JWT; inactive account
  access --> client : 401; audit denial without payloads
  client --> page : Clear in-memory session; require login; explain the lead was not saved (L2-003.4)
else Collaborator (no contact mutation in profile P)
  access --> client : 403; audit denial without payloads
  client --> page : Keep input; show that only administrators can add leads; nothing saved
else Administrator
  access -> ctrl : Authorized request
ctrl -> validation : Send CreateLeadCommand through MediatR 12.5.0
validation -> validation : L2-009 trim; names 1-100, email 1-254 and valid, phone <= 32, known category
alt Invalid request
  validation --> ctrl : 400 field errors; no business mutation
  ctrl --> client : Validation ProblemDetails
  client --> page : Keep valid input; focus linked error summary
else Valid request
  validation -> handler : Handle CreateLeadCommand
  handler -> db : Find contact with the normalized email and category
  db --> handler : Existing contact or none
  alt Normalized email/category already used
    handler --> ctrl : 409 duplicate with existing contact ID, name, category; nothing written
    ctrl --> client : Conflict ProblemDetails
    client --> page : Keep input; flag email and category; name and link the existing lead
  else Pair available
    handler -> entity : L2-009 create independent contact; preserve phone text
    entity --> handler : New lead
    handler -> db : L2-039 / L2-040 insert lead and success audit in one transaction
    alt Unique index rejects a racing duplicate
      db --> handler : Roll back insert and audit
      handler --> ctrl : 409 duplicate with the winning contact's ID, name, category
      ctrl --> client : Conflict ProblemDetails
      client --> page : Keep input; flag email and category; name and link the existing lead
    else Commit fails unexpectedly
      db --> handler : Roll back business state and success audit
      handler --> ctrl : Generic 500 with correlation ID
      ctrl --> client : Failure; no successful-save claim
      client --> page : Keep input; show reference ID; Save lead retries
    else Commit succeeds
      db --> handler : New lead ID and version
      handler --> ctrl : 201 Created with the saved lead
      ctrl --> client : Success response
      client --> page : Close dialog; refresh directory; announce the saved lead
      page --> actor : New lead listed; focus returns to Add lead
    end
  end
end
end
note over ctrl, db
Unexpected failures return generic 500 plus correlation ID (L2-043).
Diagnostics exclude secrets and contact payloads.
end note
@enduml
