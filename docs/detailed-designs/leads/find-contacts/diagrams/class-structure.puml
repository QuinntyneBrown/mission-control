@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
title Class structure - Find and read lead contacts
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
class LeadDirectoryPage {
  +routeContext: Signal<RouteContext>
  +openDialog(): void
}
class LeadDetailPage {
  +routeContext: Signal<RouteContext>
  +openDialog(): void
}
class LeadView {
  +state: Signal<FeatureState>
  +submit(): void
}
interface ILeadService {
  +search(request: ListLeadsQuery): Promise<LeadDirectoryResult>
  +read(request: GetLeadQuery): Promise<LeadDetailResult>
}
class LeadService {
  -http: HttpClient
}
class LeadsController {
  -sender: ISender
}
class LeadContact {
  +id: Guid
  +firstName: string
  +lastName: string
  +email: string
  +normalizedEmail: string
  +phone: string?
  +category: LeadCategory
  +version: long
}
class InitializationOptions {
  +designatedEmail: string
}
interface IMissionControlDataSession {
  +query(specification): Task<ReadResult>
  +commit(expectedVersion: long): Task<void>
}
class MissionControlDataSession {
  -connection: DbConnection
}
LeadDirectoryPage --> LeadView : composes
LeadDetailPage --> LeadView : composes
LeadView ..> ILeadService : inject token
ILeadService <|.. LeadService
IMissionControlDataSession <|.. MissionControlDataSession
class ListLeadsQuery {
  +search: string?
  +category: LeadCategory?
  +page: int
  +pageSize: int
}
class ListLeadsQueryHandler {
  +handle(request: ListLeadsQuery): Task<LeadDirectoryResult>
}
class LeadSummary {
  +id: Guid
  +firstName: string
  +lastName: string
  +email: string
  +phone: string?
  +category: LeadCategory
  +isCityLead: bool
}
class CategoryTotal {
  +category: LeadCategory
  +count: int
}
class LeadDirectoryResult {
  +items: LeadSummary[]
  +totalCount: int
  +page: int
  +pageSize: int
  +categoryTotals: CategoryTotal[5]
}
note bottom of LeadDirectoryResult
  categoryTotals: all five categories, zero-filled,
  over all persisted leads; search and category
  do not change them.
end note
LeadDirectoryResult *-- LeadSummary
LeadDirectoryResult *-- CategoryTotal
LeadsController ..> ListLeadsQuery : dispatches
ListLeadsQueryHandler ..> ListLeadsQuery : handles
ListLeadsQueryHandler --> LeadContact : reads
ListLeadsQueryHandler ..> LeadDirectoryResult : returns
ListLeadsQueryHandler ..> IMissionControlDataSession : uses
ListLeadsQueryHandler ..> InitializationOptions : IOptions; City Lead email
class GetLeadQuery {
  +id: Guid
}
class GetLeadQueryHandler {
  +handle(request: GetLeadQuery): Task<LeadDetailResult>
}
class ResponsibleWorkspace {
  +id: Guid
  +name: string
  +mode: DeliveryMode
}
class LeadDetailResult {
  +id: Guid
  +firstName: string
  +lastName: string
  +email: string
  +phone: string?
  +category: LeadCategory
  +version: long
  +isCityLead: bool
  +responsibleWorkspaces: ResponsibleWorkspace[]
}
note bottom of LeadDetailResult
  isCityLead: category is City and normalized email
  equals the designated email; never an account role.
end note
LeadDetailResult *-- ResponsibleWorkspace
LeadsController ..> GetLeadQuery : dispatches
GetLeadQueryHandler ..> GetLeadQuery : handles
GetLeadQueryHandler --> LeadContact : reads
GetLeadQueryHandler ..> LeadDetailResult : returns; 404 when missing
GetLeadQueryHandler ..> IMissionControlDataSession : uses
GetLeadQueryHandler ..> InitializationOptions : IOptions; City Lead email

enum LeadCategory {
  Create
  Communication
  City
  Prayer
  Event
}
LeadContact --> LeadCategory : one responsibility
@enduml
