@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
title Behavior - Search and filter the directory
actor "Authorized user" as actor
box "Frontend - Mission Control application" #E0F2FE
  participant "LeadDirectoryPage / LeadView" as page
  participant "ILeadService / LeadService" as client
end box
box "Backend - MissionControl.Api" #D1FADF
  participant "CurrentAccountAuthorization" as access
  participant "LeadsController" as ctrl
end box
box "Backend - MissionControl.Application and Domain" #ECFDF3
  participant "ValidationBehavior" as validation
  participant "ListLeadsQueryHandler" as handler
  participant "LeadContact" as entity
end box
box "Backend - MissionControl.Infrastructure" #FFF4E5
  database "Mission Control SQL" as db
end box
actor -> page : Type search text or choose a category
page -> page : Write search and category to route query; reset to page 1; show loading skeleton
page -> client : Build typed ListLeadsQuery
client -> access : GET /api/leads?search&category&page&pageSize
access -> access : L2-002 validate signature, issuer, audience, subject, expiry
access -> db : Read current status, role and credential version
db --> access : Current account access
alt Missing, invalid, or expired JWT; inactive account
  access --> client : 401; audit denial without payloads
  client --> page : Clear in-memory session; require login; restore the directory route after login
else Authenticated (every role reads contacts in profile P)
  access -> ctrl : Authorized request
ctrl -> validation : Send ListLeadsQuery through MediatR 12.5.0
validation -> validation : L2-045 page size 1-100; known category
alt Page size outside 1-100 or unknown category
  validation --> ctrl : 400 page-size or category message; nothing read
  ctrl --> client : Validation ProblemDetails
  client --> page : Show load-error state with the readable message; Try again reloads page 1 at 25 per page
else Valid request
  validation -> handler : Handle ListLeadsQuery
  handler -> db : L2-010 parameterized, escaped substring search AND category; order last name, first name, ID; one page
  db --> handler : Page rows, total matching count, five category totals
  handler -> entity : Project safe contact rows; isCityLead from category and designated email
  entity --> handler : LeadDirectoryResult
  handler --> ctrl : Typed result
  ctrl --> client : 200 items, totalCount, categoryTotals
  alt A newer search started meanwhile
    client -> client : Discard this older response
  else Latest search
    alt Zero matches
      client --> page : Show zero-result message with Clear filter; announce "No <category> leads found"
    else Matches
      client --> page : Render rows, pagination, and chip counts; announce "N leads found"
    end
    page --> actor : Results, counts, and controls stay reachable at every width
  end
end
end
note over ctrl, db
Unexpected failures return generic 500 plus correlation ID (L2-043);
the page shows its load-error state with the reference ID and Try again.
Diagnostics exclude secrets and contact payloads.
end note
@enduml
