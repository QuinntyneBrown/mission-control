@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components - Find and read lead contacts
Container(web, "Mission Control web client", "Angular", "LeadDirectoryPage, LeadDetailPage / LeadDirectoryView, LeadDetailView")
ContainerDb(db, "Mission Control database", "SQL", "Versioned feature records and audit events")
Container_Boundary(api, "MissionControl.Api runtime") {
  Component(ctrl, "LeadsController", "API boundary", "Binds request and dispatches through MediatR 12.5.0")
  Component(access, "CurrentAccountAuthorization", "API authentication / authorization", "Validates JWT and checks current SQL account access")
  Component(validation, "ValidationBehavior", "Application pipeline", "Invokes request validators")
  Component(entity, "LeadContact", "Domain entity", "Contact fields and category; City Lead from designated email")
  Component(store, "MissionControlDataSession", "Infrastructure", "Implements IMissionControlDataSession typed reads with parameterized SQL")
Rel(web, access, "Reads through leadsResource and leadResource (ILeadService / LeadService)", "HTTPS")
Rel(access, db, "Checks current access for protected requests", "SQL")
Rel(access, ctrl, "Forwards authorized request")
Rel(ctrl, validation, "Sends typed request")
Component(h0, "ListLeadsQueryHandler", "Application / MediatR", "Search and filter the directory")
Rel(validation, h0, "Dispatches validated request")
Rel(h0, entity, "Projects LeadSummary rows")
Rel(h0, store, "Reads rows, total, and category totals in one snapshot")
Component(h1, "GetLeadQueryHandler", "Application / MediatR", "Read lead details")
Rel(validation, h1, "Dispatches validated request")
Rel(h1, entity, "Projects LeadDetailResult")
Rel(h1, store, "Reads lead, responsible count, and first 10 workspaces in one snapshot")
}
Rel(store, db, "Executes bounded, parameterized reads", "SQL")
@enduml
