@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components - Start a sprint and change its active scope
Container(web, "Mission Control web client", "Angular", "SprintsPage, SprintPlanningPage, SprintBoardPage, BacklogPage, work pages; StartSprintDialog, SprintScopeDialog / SprintStartView, SprintScopeForm")
ContainerDb(db, "Mission Control database", "SQL", "Versioned feature records and audit events")
Container_Boundary(api, "MissionControl.Api runtime") {
  Component(ctrl, "SprintsController", "API boundary", "Binds request and dispatches through MediatR 12.5.0")
  Component(access, "CurrentAccountAuthorization", "API authentication / authorization", "Validates JWT and checks current SQL account access")
  Component(validation, "ValidationBehavior", "Application pipeline", "Invokes request validators")
  Component(entity, "Sprint / ActiveSprintSlot / SprintScopeChange", "Domain", "Start with initial-scope rows, one active sprint per workspace, recorded scope changes")
  Component(store, "MissionControlDataSession", "Infrastructure", "Implements IMissionControlDataSession: typed sprint loads, AddActiveSprintSlot, AddBoardState, AddAuditEvent, workspace transaction, SaveChangesAsync")
Rel(web, access, "Calls through ISprintService / SprintService", "HTTPS")
Rel(access, db, "Checks current access for protected requests", "SQL")
Rel(access, ctrl, "Forwards authorized request")
Rel(ctrl, validation, "Sends typed request")
Component(h0, "StartSprintCommandHandler", "Application / MediatR", "Start a planned sprint")
Rel(validation, h0, "Dispatches validated request")
Rel(h0, entity, "start(at, actorId); claims the active slot")
Rel(h0, store, "Workspace transaction; SaveChangesAsync")
Component(h1, "ChangeSprintScopeCommandHandler", "Application / MediatR", "Explicitly add or remove active stories")
Rel(validation, h1, "Dispatches validated request")
Rel(h1, entity, "changeScope(add, remove, at, actorId)")
Rel(h1, store, "Workspace transaction; SaveChangesAsync")
}
Rel(store, db, "Executes bounded queries / atomic writes", "SQL")
@enduml
