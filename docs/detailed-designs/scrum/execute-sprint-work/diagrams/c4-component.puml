@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components - Execute work on the active sprint board
Container(web, "Mission Control web client", "Angular", "SprintBoardPage / BoardView (one pending move per board; generation-stamped reads; sprintLoaded header)")
ContainerDb(db, "Mission Control database", "SQL", "Versioned feature records and audit events")
Container_Boundary(api, "MissionControl.Api runtime") {
  Component(ctrl, "BoardsController", "API boundary", "Binds request and dispatches through MediatR 12.5.0")
  Component(access, "CurrentAccountAuthorization", "API authentication / authorization", "Validates JWT and checks current SQL account access")
  Component(validation, "ValidationBehavior", "Application pipeline", "Invokes request validators")
  Component(entity, "ActiveSprintBoardResult", "Application read projection", "Sprint header with version and server totals, and current-scope columns; cards without descriptions")
  Component(store, "MissionControlDataSession", "Infrastructure", "Implements IMissionControlDataSession: LoadActiveSprintBoardAsync with set-based task counts")
Rel(web, access, "Calls through IBoardService / BoardService", "HTTPS")
Rel(access, db, "Checks current access for protected requests", "SQL")
Rel(access, ctrl, "Forwards authorized request")
Rel(ctrl, validation, "Sends typed request")
Component(h0, "GetActiveSprintBoardQueryHandler", "Application / MediatR", "Read current sprint board")
Rel(validation, h0, "Dispatches validated request")
Rel(h0, entity, "Returns")
Rel(h0, store, "Typed board read")
}
Rel(store, db, "Executes bounded queries", "SQL")
@enduml
