@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
title Class structure - Execute work on the active sprint board
top to bottom direction
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
set separator none
package "MissionControl.Api" {
  class BoardsController {
    -sender: ISender
  }
}
package "MissionControl.Application" {
  class GetActiveSprintBoardQuery {
    +workspaceId: Guid
    +status: WorkStatus?
    +page: int
    +pageSize: int
  }
  class GetActiveSprintBoardQueryHandler {
    +handle(request: GetActiveSprintBoardQuery, ct: CancellationToken): Task<ActiveSprintBoardResult>
  }
  class ActiveSprintBoardResult {
    +sprintId: Guid?
    +name: string?
    +version: long?
    +goal: string?
    +startDate: DateOnly?
    +endDate: DateOnly?
    +startedAtUtc: DateTimeOffset?
    +startedByName: string?
    +initialScopeCount: int
    +scopeChangeCount: int
    +storyCount: int
    +doneCount: int
    +points: int
    +donePoints: int
    +nextPlannedSprint: SprintPeriod?
    +latestClosedSprint: SprintReference?
    +workspaceStoryTotal: int
    +board: BoardResult?
  }
  note right of ActiveSprintBoardResult
    Totals cover the whole current scope,
    computed by the server, never from loaded cards.
    Every read returns the header, a Load more batch
    or a post-move reread included.
    latestClosedSprint: latest closure, then ID; read
    when no sprint is active or planned.
    workspaceStoryTotal: stories in the whole workspace;
    zero makes the create action Add initiative.
  end note
  class SprintPeriod {
    +sprintId: Guid
    +name: string
    +startDate: DateOnly
    +endDate: DateOnly
  }
  class SprintReference {
    +sprintId: Guid
    +name: string
  }
  class BoardResult {
    +boardId: Guid
    +boardVersion: long
    +sprintsPaused: bool
    +columns: BoardColumn[]
  }
  note right of BoardResult
    sprintsPaused is always false on a sprint board.
  end note
  class BoardColumn {
    +status: WorkStatus
    +totalCount: int
    +cards: BoardCard[]
  }
  class BoardCard {
    +storyId: Guid
    +key: string
    +title: string
    +epicTitle: string
    +assigneeName: string?
    +status: WorkStatus
    +position: int
    +completedTasks: int
    +totalTasks: int
    +estimate: int?
    +storyVersion: long
  }
  note bottom of BoardCard
    No description. Task counts come from one
    set-based aggregate per batch, never per card.
  end note
  class MoveStoryCommand {
    +workspaceId: Guid
    +storyId: Guid
    +sprintBoardId: Guid?
    +destination: WorkStatus
    +targetPosition: int
    +expectedStoryVersion: long
    +expectedBoardVersion: long
    +completionCondition: StoryCompletionCondition?
  }
  note bottom of MoveStoryCommand
    Sent by IBoardService.move with sprintBoardId
    set to the active sprint; handled by kanban
    move-story-cards.
  end note
  interface IMissionControlDataSession {
    +LoadActiveSprintBoardAsync(query: GetActiveSprintBoardQuery, ct: CancellationToken): Task<ActiveSprintBoardResult?>
  }
  note bottom of IMissionControlDataSession
    Scoped view of the shared port defined in the overview;
    this read-only slice uses one typed read. Moves use the
    kanban move-story-cards members.
  end note
}
BoardsController ..> GetActiveSprintBoardQuery : dispatches
GetActiveSprintBoardQueryHandler ..> GetActiveSprintBoardQuery : handles
GetActiveSprintBoardQueryHandler --> ActiveSprintBoardResult : returns
GetActiveSprintBoardQueryHandler ..> IMissionControlDataSession : LoadActiveSprintBoardAsync
ActiveSprintBoardResult --> SprintPeriod : next planned sprint
ActiveSprintBoardResult --> SprintReference : latest closed sprint
ActiveSprintBoardResult *-- BoardResult
BoardResult *-- BoardColumn
BoardColumn *-- BoardCard
@enduml
