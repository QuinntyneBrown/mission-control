@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
title Behavior - Read current sprint board
actor "Authorized user" as actor
box "Frontend - Mission Control application" #E0F2FE
  participant "SprintBoardPage / BoardView" as page
  participant "IBoardService / BoardService" as client
end box
box "Backend - MissionControl.Api" #D1FADF
  participant "CurrentAccountAuthorization" as access
  participant "BoardsController" as ctrl
end box
box "Backend - MissionControl.Application and Domain" #ECFDF3
  participant "ValidationBehavior" as validation
  participant "GetActiveSprintBoardQueryHandler" as handler
  participant "SprintBoardCard" as entity
end box
box "Backend - MissionControl.Infrastructure" #FFF4E5
  database "Mission Control SQL" as db
end box
actor -> page : Open the Board tab of a Scrum project
page -> client : Build typed GetActiveSprintBoardQuery with status batch and size
client -> access : GET /api/workspaces/{id}/active-sprint/board
access -> access : L2-002 validate signature, issuer, audience, subject, expiry
access -> db : Read current status, role and credential version
db --> access : Current account access
alt Missing, invalid or expired JWT; deactivated account
  access --> client : 401; audit denial without payloads
  client --> page : Clear session; sign in with the board as return route
else Authenticated without the required permission
  access --> client : 403; audit denial without payloads
  client --> page : Access-denied state; nothing loaded
else Authorized
  access -> ctrl : Authorized request
  ctrl -> validation : Send GetActiveSprintBoardQuery through MediatR 12.5.0
  validation -> validation : L2-045 batch size 1-100; known status
  alt Invalid batch size or status
    validation --> ctrl : 400 field errors; nothing read
    ctrl --> client : Validation ProblemDetails
    client --> page : Load-failed state with Try again
  else Valid request
    validation -> handler : Handle GetActiveSprintBoardQuery
    handler -> db : Read workspace mode, active sprint, and planned sprint summary
    db --> handler : Mode and sprint summary
    alt Workspace not found
      handler --> ctrl : 404
      ctrl --> client : ProblemDetails (not found)
      client --> page : Project not-found state linking to Projects
    else Workspace in Kanban mode (L2-027.3)
      handler --> ctrl : 409 sprints paused
      ctrl --> client : ProblemDetails (sprints paused)
      client --> page : Route to the workspace Kanban board; sprint plans stay on the Sprints tab
    else No active sprint
      handler --> ctrl : No-active view with the next planned sprint, or none
      ctrl --> client : 200 without board columns
      client --> page : Planned sprint: Start and Plan sprint; no sprints: Plan sprint and Open Work
    else Active sprint
      handler -> db : L2-024 read current open membership in bounded status batches of at most 100
      db --> handler : Cards, shared story status, task counts, full column totals
      handler -> entity : Project one SprintBoardCard per allocated story in its status column
      entity --> handler : Active sprint board
      handler --> ctrl : Board with goal, dates, start actor, scope log, versions
      ctrl --> client : 200 with board and versions
      client --> page : Update signals; an empty sprint keeps all three columns and Add stories
      page --> actor : Columns with Move on every card and Remove on unfinished cards
    end
  end
end
note over ctrl, db
Unexpected failures return generic 500 plus correlation ID (L2-043); the page shows Load failed with Try again.
Moves send MoveStoryCommand with sprintBoardId; a 409 unfinished-tasks opens UnfinishedTasksDialog.
Diagnostics exclude secrets and contact payloads.
end note
@enduml
