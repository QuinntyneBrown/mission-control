@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
title Behavior - Create planned sprint
actor "Authorized user" as actor
box "Frontend - Mission Control application" #E0F2FE
  participant "SprintsPage / SprintFormDialog / SprintView" as page
  participant "ISprintService / SprintService" as client
end box
box "Backend - MissionControl.Api" #D1FADF
  participant "CurrentAccountAuthorization" as access
  participant "SprintsController" as ctrl
end box
box "Backend - MissionControl.Application and Domain" #ECFDF3
  participant "ValidationBehavior" as validation
  participant "CreateSprintCommandHandler" as handler
  participant "Sprint" as entity
end box
box "Backend - MissionControl.Infrastructure" #FFF4E5
  database "Mission Control SQL" as db
end box
actor -> page : Plan sprint with name, goal, and Toronto start and end dates
page -> client : Build typed CreateSprintCommand
client -> access : POST /api/workspaces/{id}/sprints
access -> access : L2-002 validate signature, issuer, audience, subject, expiry
access -> db : Read current status, role and credential version
db --> access : Current account access
alt Missing, invalid or expired JWT; deactivated account
  access --> client : 401; audit denial without payloads
  client --> page : Clear session; sign in with the Sprints tab as return route
else Authenticated without the required permission
  access --> client : 403; audit denial without payloads
  client --> page : Keep input; explain that planning sprints is not permitted
else Authorized
  access -> ctrl : Authorized request
  ctrl -> validation : Send CreateSprintCommand through MediatR 12.5.0
  validation -> validation : L2-022 trim; name 1-200, goal 1-2,000, valid dates, end on or after start
  alt Missing, over-limit or malformed fields; end before start
    validation --> ctrl : 400 field errors; nothing read or changed
    ctrl --> client : Validation ProblemDetails
    client --> page : Keep all input; focus the linked error summary
  else Valid request
    validation -> handler : Handle CreateSprintCommand
    handler -> db : Lock workspace; read existence and delivery mode
    db --> handler : Workspace and mode
    alt Workspace not found
      handler --> ctrl : 404; nothing created
      ctrl --> client : ProblemDetails (not found)
      client --> page : Close dialog; project not-found state linking to Projects
    else Workspace in Kanban mode (L2-027.3)
      handler --> ctrl : 409 sprints paused; nothing created
      ctrl --> client : ProblemDetails (sprints paused)
      client --> page : Keep input; explain that sprints are paused in Kanban mode; no retry
    else Scrum mode
      handler -> entity : L2-022 create Planned sprint with Toronto dates and version 1
      entity --> handler : New planned sprint
      handler -> db : L2-039 / L2-040 insert sprint and success audit in one transaction
      alt Commit fails
        db --> handler : Roll back sprint and success audit
        handler --> ctrl : Generic 500 with correlation ID
        ctrl --> client : Failure; no successful-save claim
        client --> page : Keep all input; failed state shows the reference ID; Save retries
      else Commit succeeds
        db --> handler : New sprint ID and version
        handler --> ctrl : Created sprint
        ctrl --> client : 201 with sprint ID and version
        client --> page : Update signal state
        page --> actor : Announce the planned sprint; open sprint planning to choose stories
      end
    end
  end
end
note over ctrl, db
Unexpected failures return generic 500 plus correlation ID (L2-043).
Diagnostics exclude secrets and contact payloads.
end note
@enduml
