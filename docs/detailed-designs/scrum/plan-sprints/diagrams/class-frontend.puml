  +sprintCandidatesResource(query: () => GetSprintCandidatesQuery | undefined): ResourceRef<SprintCandidatePage>
  +sprintMembersResource(query: () => GetSprintMembersQuery | undefined): ResourceRef<SprintMemberPage>
  +create(command: CreateSprintCommand): Promise<SprintSaveResult>
  +savePlan(command: SaveSprintPlanCommand): Promise<SprintSaveResult>
}
class SprintService {
  -http: HttpClient
}
note right of ISprintService
Reads return a caller-owned signal resource created in the
consumer's injection context; it aborts a superseded request
when the query signal changes and when the consumer is destroyed.
Mutations return a promise. No RxJS type crosses api.
end note
interface IWorkspaceService {
  +workspaceResource(query: () => GetWorkspaceQuery | undefined): ResourceRef<WorkspaceDetail>
}
note right of IWorkspaceService
Defined by projects manage-workspaces
(workspace.service.contract.ts).
end note
SprintsPage --> SprintListView : composes; outputs carry the sprint ID
SprintsPage ..> SprintFormDialog : opens (Plan sprint, Edit)
SprintsPage ..> OtherDialogs : opens (Start, Change scope, Close sprint)
SprintsPage ..> ProjectLayoutPage : revision; workspace(); setTabAction(Plan sprint); openDialog(ChangeMode); modeChanged(); refresh()
SprintPlanningPage --> SprintPlanView : composes; editRequested, startRequested
SprintPlanningPage ..> SprintFormDialog : opens (Edit details)
SprintPlanningPage ..> OtherDialogs : opens StartSprintDialog; CloseSprintDialog on CloseSprint
SprintPlanningPage ..> IWorkspaceService : inject token; workspaceResource
SprintFormDialog --> SprintForm : composes
SprintFormDialog ..> SprintFormOutcome : close result
SprintListView ..> ISprintService : inject token
SprintForm ..> ISprintService : inject token
SprintPlanView ..> ISprintService : inject token
ISprintService <|.. SprintService
@enduml
