@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components - Plan sprints and allocate stories
Container(web, "Mission Control web client", "Angular", "SprintsPage, SprintPlanningPage, SprintFormDialog / SprintListView, SprintPlanView, SprintForm (draftChange)")
ContainerDb(db, "Mission Control database", "SQL", "Versioned feature records and audit events")
Container_Boundary(api, "MissionControl.Api runtime") {
  Component(ctrl, "SprintsController", "API boundary", "Binds request and dispatches through MediatR 12.5.0")
  Component(access, "CurrentAccountAuthorization", "API authentication / authorization", "Validates JWT and checks current SQL account access")
  Component(validation, "ValidationBehavior", "Application pipeline", "Invokes request validators")
  Component(entity, "Sprint / OpenSprintMembership", "Domain", "Planned fields and the add/remove delta on saved membership")
  Component(store, "MissionControlDataSession", "Infrastructure", "Implements IMissionControlDataSession: typed Load and List reads, AddSprint, AddAuditEvent, workspace transaction, SaveChangesAsync")
Rel(web, access, "Calls through ISprintService / SprintService", "HTTPS")
Rel(access, db, "Checks current access for protected requests", "SQL")
Rel(access, ctrl, "Forwards authorized request")
Rel(ctrl, validation, "Sends typed request")
Component(h0, "CreateSprintCommandHandler", "Application / MediatR", "Create planned sprint")
Rel(validation, h0, "Dispatches validated request")
Rel(h0, entity, "Creates a planned sprint")
Rel(h0, store, "Workspace transaction; inserts sprint")
Component(h1, "SaveSprintPlanCommandHandler", "Application / MediatR", "Edit planned fields and apply the story delta")
Rel(validation, h1, "Dispatches validated request")
Rel(h1, entity, "Validates new allocations; applies the delta")
Rel(h1, store, "Workspace transaction; SaveChangesAsync")
Component(h5, "ListSprintsQueryHandler", "Application / MediatR", "Sprints tab: active, a page of planned, a page of closed")
Rel(validation, h5, "Dispatches validated request")
Rel(h5, store, "Typed sprint list")
Component(h2, "GetSprintPlanQueryHandler", "Application / MediatR", "One plan header")
Rel(validation, h2, "Dispatches validated request")
Rel(h2, store, "Typed plan header read")
Component(h3, "GetSprintCandidatesQueryHandler", "Application / MediatR", "One searched page of stories outside the sprint")
Rel(validation, h3, "Dispatches validated request")
Rel(h3, store, "Typed candidate page read")
Component(h4, "GetSprintMembersQueryHandler", "Application / MediatR", "One page of saved members")
Rel(validation, h4, "Dispatches validated request")
Rel(h4, store, "Typed member page read")
}
Rel(store, db, "Executes bounded queries / atomic writes", "SQL")
@enduml
