@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
title Behavior - Read recorded closure outcomes
actor "Authorized user" as actor
box "Frontend - Mission Control application" #E0F2FE
  participant "SprintHistoryPage / SprintView" as page
  participant "ISprintService / SprintService" as client
end box
box "Backend - MissionControl.Api" #D1FADF
  participant "CurrentAccountAuthorization" as access
  participant "SprintsController" as ctrl
end box
box "Backend - MissionControl.Application and Domain" #ECFDF3
  participant "ValidationBehavior" as validation
  participant "GetSprintHistoryQueryHandler" as handler
  participant "SprintSnapshot" as entity
end box
box "Backend - MissionControl.Infrastructure" #FFF4E5
  database "Mission Control SQL" as db
end box
actor -> page : Open a closed sprint from the Sprints tab history list
page -> client : Build typed GetSprintHistoryQuery with outcome page and page size
client -> access : GET /api/workspaces/{id}/sprints/{sprintId}/history
access -> access : L2-002 validate signature, issuer, audience, subject, expiry
access -> db : Read current status, role and credential version
db --> access : Current account access
alt Missing, invalid or expired JWT; deactivated account
  access --> client : 401; audit denial without payloads
  client --> page : Clear session; sign in with this history route as return route
else Authenticated without the required permission
  access --> client : 403; audit denial without payloads
  client --> page : Access-denied state; nothing loaded
else Authorized
  access -> ctrl : Authorized request
  ctrl -> validation : Send GetSprintHistoryQuery through MediatR 12.5.0
  validation -> validation : L2-045 page size 1-100, default 25
  alt Invalid page or page size
    validation --> ctrl : 400 field errors; nothing read
    ctrl --> client : Validation ProblemDetails
    client --> page : Load-failed state; Try again uses the default page size
  else Valid request
    validation -> handler : Handle GetSprintHistoryQuery
    handler -> db : L2-026 read closure snapshot, scope log, and one bounded page of recorded outcomes
    db --> handler : Snapshot and full outcome counts
    alt No closure snapshot (sprint missing, in another workspace, or not closed)
      handler --> ctrl : 404
      ctrl --> client : ProblemDetails (not found)
      client --> page : Sprint not found state with Back to sprints
    else Snapshot found
      handler -> db : Look up which recorded story IDs still exist and their current titles
      db --> handler : Live story IDs and titles (links and renamed notes only)
      handler -> entity : Keep recorded titles, statuses, destinations, actors; mark stories deleted after closure
      entity --> handler : Read-only history view
      handler --> ctrl : History with full completed and unfinished counts
      ctrl --> client : 200 with history
      client --> page : Deleted stories show recorded ID, title, status and a Deleted label, without a link
      page --> actor : Present recorded fields, start and close actors, scope changes, outcomes
    end
  end
end
note over ctrl, db
History stays readable in Kanban mode. No snapshot edit endpoint exists;
closed-sprint mutations return 409 (L2-026.3).
Unexpected failures return generic 500 plus correlation ID (L2-043).
Diagnostics exclude secrets and contact payloads.
end note
@enduml
