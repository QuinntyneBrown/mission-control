@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components - Read immutable sprint history
Container(web, "Mission Control web client", "Angular", "SprintHistoryPage / SprintHistoryView")
ContainerDb(db, "Mission Control database", "SQL", "Immutable closure snapshots, initial scope, scope changes, and live work records")
Container_Boundary(api, "MissionControl.Api runtime") {
  Component(ctrl, "SprintsController", "API boundary", "Binds request and dispatches through MediatR 12.5.0")
  Component(access, "CurrentAccountAuthorization", "API authentication / authorization", "Validates JWT and checks current SQL account access")
  Component(validation, "ValidationBehavior", "Application pipeline", "Invokes request validators")
  Component(store, "MissionControlDataSession", "Infrastructure", "Implements IMissionControlDataSession: LoadSprintHistoryHeaderAsync, ListSprintOutcomesAsync, ListSprintScopeChangesAsync; one batched live-title lookup per outcome page")
Rel(web, access, "Calls through ISprintService / SprintService", "HTTPS")
Rel(access, db, "Checks current access for protected requests", "SQL")
Rel(access, ctrl, "Forwards authorized request")
Rel(ctrl, validation, "Sends typed request")
Component(h0, "GetSprintHistoryQueryHandler", "Application / MediatR", "Snapshot header with actors and counts")
Rel(validation, h0, "Dispatches validated request")
Rel(h0, store, "Typed header read")
Component(h1, "GetSprintOutcomesQueryHandler", "Application / MediatR", "One page of recorded outcomes")
Rel(validation, h1, "Dispatches validated request")
Rel(h1, store, "Typed outcome page read; batched live lookup")
Component(h2, "GetSprintScopeChangesQueryHandler", "Application / MediatR", "One page of recorded scope changes")
Rel(validation, h2, "Dispatches validated request")
Rel(h2, store, "Typed scope-change page read")
}
Rel(store, db, "Executes bounded read-only queries", "SQL")
@enduml
